{
	"useTabs": true,
	"tabWidth": 2,
	"bracketSameLine": true,
	"plugins": ["prettier-plugin-astro"],
	"overrides": [
		{
			"files": "*.astro",
			"options": { "parser": "astro" }
		},
		{
			"files": ["*.md", "*.mdx", "*.json", "*.jsonc", "*.yml", "*.yaml", "*.toml"],
			"options": { "useTabs": false }
		}
	]
}
