---
import "aos/dist/aos.css";
import { SEO } from "astro-seo";

import "../styles/global.css";
import "@fontsource-variable/inter/index.css";
import Footer from "@components/footer.astro";
import AIAgent from "@components/AIAgent.svelte";
import Contact from "@components/Contact.astro";
import Navbar from "@components/navbar/index.astro";
import { DEFAULT_LOCALE, getLocaleFromURL, type SupportedLocale } from "../i18n";

export interface Props {
	title: string;
	locale?: SupportedLocale;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
	"/opengraph.png",
	Astro.site
).toString();

// Get locale from URL or use default
const pathLocale = getLocaleFromURL(Astro.url.pathname);
const { title, locale = pathLocale || DEFAULT_LOCALE } = Astro.props;
const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<script
			type="text/partytown"
			async
			src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
		<script type="text/partytown" define:vars={{ gaId }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());

			gtag("config", gaId);
		</script>

		{/* Theme script - MUST be inline for fast theme application */}
		<script is:inline>
			// Immediately set the theme to avoid flash of wrong theme
			const savedTheme = localStorage.getItem('theme');
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			
			if (savedTheme === 'light' || (!savedTheme && !prefersDark)) {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
		</script>

		<!-- <link rel="preload" as="image" href={src} alt="Hero" /> -->
		<SEO
			title={title}
			description="Numen Games is a webpage for the company Numen Games S.L"
			canonical={canonicalURL}
			twitter={{
				creator: "@numengames",
				site: "@numengames",
				card: "summary_large_image",
			}}
			openGraph={{
				basic: {
					url: canonicalURL,
					type: "website",
					title: `Numen Games`,
					image: resolvedImageWithDomain,
				},
				image: {
					alt: "",
				},
			}}
		/>
	</head>
	<body>
		<Navbar locale={locale} />
		<slot />
		<Contact locale={locale} />
		<Footer />
		<!-- <AIAgent /> -->
		<style is:global>
			/* Improve Page speed */
			/* https://css-tricks.com/almanac/properties/c/content-visibility/ */
			html,
			body {
				width: 100%;
				height: 100%;
				background-color: #212123;
				overflow-x: clip;
			}

			img {
				content-visibility: auto;
			}
		</style>
		<script>
			import AOS from "aos";
			AOS.init({
				duration: 800,
				once: false,
			});
		</script>
	</body>
</html>
