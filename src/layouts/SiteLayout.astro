---
// Layout de la reconstrucción (borrador). Reemplaza el layout legacy
// para las rutas nuevas; el árbol [locale] antiguo sigue usando
// Layout.astro (retirado a redirects, ver commit ccb62df).
import { SEO } from "astro-seo";
import "../styles/tokens.css";
import "../styles/site.css";
import SiteHeader from "@components/site/SiteHeader.astro";
import SiteFooter from "@components/site/SiteFooter.astro";
import SkipLink from "@components/site/SkipLink.astro";
import { type SupportedLocale } from "@lib/locale";

export interface Props {
	title: string;
	description: string;
	locale: SupportedLocale;
	/** Ruta actual sin locale, p.ej. "/experiencias" o "/" */
	path: string;
}

const { title, description, locale, path } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
// JPEG de 1200x630 (134 KB). El PNG anterior pesaba 3,4 MB a 1536x1024:
// fuera del ratio canónico de Open Graph y por encima del límite de
// descarga de varios clientes, que simplemente no mostraban imagen.
const resolvedImage = new URL("/og-card.png", Astro.site).toString();
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			/* Day and night (DSN-016), the numinia.com boot copied: runs before
			   first paint so a stored choice never flashes. Stored choice >
			   device preference. No attribute means Nocturno. The key is the
			   one the cookie policy names (numinia-modo). */
			try {
				var sm = localStorage.getItem("numinia-modo");
				if (sm === "diurno" || (sm !== "nocturno" && matchMedia("(prefers-color-scheme: light)").matches)) document.documentElement.dataset.modo = "diurno";
			} catch {}
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#14110F" />
		<meta name="generator" content={Astro.generator} />

		<SEO
			title={title}
			description={description}
			canonical={canonicalURL}
			openGraph={{
				basic: {
					title,
					type: "website",
					image: resolvedImage,
				},
				optional: {
					description,
					siteName: "Numen Games",
					locale: locale === "es" ? "es_ES" : "en_US",
				},
			}}
			twitter={{
				card: "summary_large_image",
				image: resolvedImage,
			}}
		/>

		<link rel="alternate" hreflang="es" href={new URL(`/es${path}`, Astro.site).toString()} />
		<link rel="alternate" hreflang="en" href={new URL(`/en${path}`, Astro.site).toString()} />
		<link rel="alternate" hreflang="x-default" href={new URL(`/es${path}`, Astro.site).toString()} />
	</head>
	<body>
		<SkipLink locale={locale} />
		<SiteHeader locale={locale} currentPath={path} />
		<main id="contenido">
			<slot />
		</main>
		<SiteFooter locale={locale} />
	</body>
</html>
