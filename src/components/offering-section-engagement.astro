---
import { Picture } from "astro:assets";

import Container from "@components/Container.svelte";
import SelfPacedTrainingImage from "assets/self-paced-training.webp";
import VirtualExpertGuidedTrainingImage from "assets/virtual-expert-guided-training.webp";
import CollaborativeMultiplayerSkillTrainingImage from "assets/collaborative-multiplayer-skill-training.webp";
---

<Container
	class="grid lg:grid-cols-1 place-items-center py-8 sm:py-12 md:py-16">
	<div class="flex flex-col items-center px-4 sm:px-6 lg:px-12">
		<h2
			class="text-center mb-4 sm:mb-6 text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-extrabold lg:tracking-tight xl:tracking-tighter">
			Discover what we offer
		</h2>
		<p class="text-center text-base sm:text-lg md:text-xl lg:text-2xl font-medium mt-4 sm:mt-6 md:mt-8 max-w-3xl">
			High adaptability experiences to different organizational needs
		</p>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 pt-8 sm:pt-12 md:pt-16 pb-8 sm:pb-12 md:pb-16">
			<div class="flex items-center flex-col p-4 sm:p-6 hover:scale-[1.02] transition-transform duration-300">
				<Picture
					src={SelfPacedTrainingImage}
					class="w-full max-w-sm mb-4 sm:mb-6 rounded-lg shadow-lg"
					alt="self_paced_training_image"
				/>
				<h4 class="font-semibold text-xl sm:text-2xl text-center max-w-sm mb-3 sm:mb-4">
					Onboarding
				</h4>
				<p class="text-base sm:text-lg font-regular text-slate-500 text-center max-w-sm">
					Streamline and energize your onboarding process with immersive 3D
					environments that introduce new hires to your company's culture, values,
					and structure. This results in faster integration and deeper engagement,
					helping employees feel like part of the team from day one.
				</p>
			</div>

			<div class="flex items-center flex-col p-4 sm:p-6 hover:scale-[1.02] transition-transform duration-300">
				<Picture
					src={VirtualExpertGuidedTrainingImage}
					class="w-full max-w-sm mb-4 sm:mb-6 rounded-lg shadow-lg"
					alt="virtual_expect_guided_training_image"
				/>
				<h4 class="font-semibold text-xl sm:text-2xl text-center max-w-sm mb-3 sm:mb-4">Culture</h4>
				<p class="text-base sm:text-lg font-regular text-slate-500 text-center max-w-sm">
					Create lasting engagement with gamified programs that reinforce your
					organization's core values. Our solutions help strengthen company
					culture over time, ensuring that employees remain connected to your
					mission and values, leading to higher retention and morale.
				</p>
			</div>

			<div class="flex items-center flex-col p-4 sm:p-6 hover:scale-[1.02] transition-transform duration-300">
				<Picture
					src={CollaborativeMultiplayerSkillTrainingImage}
					class="w-full max-w-sm mb-4 sm:mb-6 rounded-lg shadow-lg"
					alt="collaborative_multiplayer_skill_training_image"
				/>
				<h4 class="font-semibold text-xl sm:text-2xl text-center max-w-sm mb-3 sm:mb-4">Values</h4>
				<p class="text-base sm:text-lg font-regular text-slate-500 text-center max-w-sm">
					Identify and retain top talent with interactive 3D assessments that
					measure how well candidates and employees align with your company's
					culture and values. Our value-driven assessments ensure a stronger
					cultural fit and long-term success for your team.
				</p>
			</div>
		</div>
	</div>
</Container>
