---
import { Icon } from "astro-icon/components";

import Container from "@components/Container.svelte";
---

<Container>
	<div class="flex flex-col justify-center items-center text-center px-4 sm:px-6 lg:px-12">
		<h3 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4 sm:mb-6 lg:mb-8">Pillars</h3>
		<p class="text-center text-base sm:text-lg md:text-xl lg:text-2xl font-medium mt-2 sm:mt-4 max-w-3xl">This is what we consider in every decision</p>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 pt-8 sm:pt-12 md:pt-16">
		<div class="hover:scale-[1.02] transition-transform duration-300">
			<div class="flex flex-col items-center text-center p-4 sm:p-6">
				<Icon class="h-16 w-16 sm:h-20 sm:w-20 lg:h-24 lg:w-24 mb-4 sm:mb-6" name="art-driver" />
				<h4 class="text-xl sm:text-2xl font-semibold mb-2 sm:mb-3">Craft</h4>
				<h5 class="text-base sm:text-lg text-nocturno-texto2">Art as a driver</h5>
			</div>
		</div>
		<div class="hover:scale-[1.02] transition-transform duration-300">
			<div class="flex flex-col items-center text-center p-4 sm:p-6">
				<Icon class="h-16 w-16 sm:h-20 sm:w-20 lg:h-24 lg:w-24 mb-4 sm:mb-6" name="play-to-learn" />
				<h4 class="text-xl sm:text-2xl font-semibold mb-2 sm:mb-3">Learn</h4>
				<h5 class="text-base sm:text-lg text-nocturno-texto2">Humans play to learn.</h5>
			</div>
		</div>
		<div class="hover:scale-[1.02] transition-transform duration-300">
			<div class="flex flex-col items-center text-center p-4 sm:p-6">
				<Icon class="h-16 w-16 sm:h-20 sm:w-20 lg:h-24 lg:w-24 mb-4 sm:mb-6" name="copy-and-make-better" />
				<h4 class="text-xl sm:text-2xl font-semibold mb-2 sm:mb-3">Remix</h4>
				<h5 class="text-base sm:text-lg text-nocturno-texto2">Feel free to copy it and make it better.</h5>
			</div>
		</div>
	</div>
</Container>
