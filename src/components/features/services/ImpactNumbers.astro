---
import Container from "@components/Container.svelte";

import BracketedContent from "@components/BracketedContent.svelte";
import CardWithHighlightNumber from "@components/cards/WithHighlightNumber.astro";

const { textObj } = Astro.props;
---

<Container
	className="flex flex-col items-center justify-center py-12 md:py-16 lg:py-24 xl:pt-28"
	bgColor="bg-primary-panther">
	<div class="flex flex-col items-center relative w-full px-4 md:px-8 lg:px-0">
		<div class="flex flex-col justify-center items-center z-10 mb-8 md:mb-12 lg:mb-14 w-full md:w-[80%] lg:w-[60%]">
			<BracketedContent
				className="text-primary-beige/75"
				text={textObj?.bracketedContent}
			/>
			<h2
				class="text-2xl md:text-3xl lg:text-4xl 2xl:text-5xl font-normal text-center mt-3 mb-4 md:mb-6 text-primary-beige">
				{textObj?.header?.titlePart1}
				<span class="text-primary-coralRed">{textObj?.header?.titlePart2}</span>
			</h2>
			<h3
				class="w-full md:w-[75%] text-sm md:text-base font-light text-primary-beige/75 text-center mb-6">
				{textObj?.header?.subtitle}
			</h3>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 w-full max-w-7xl">
			<CardWithHighlightNumber
				kpi={textObj?.cards[0]?.kpi}
				text={textObj?.cards[0]?.text}
				link={textObj?.cards[0]?.link}
				linkText={textObj?.cards[0]?.linkText}
			/>
			<CardWithHighlightNumber
				kpi={textObj?.cards[1]?.kpi}
				text={textObj?.cards[1]?.text}
				link={textObj?.cards[1]?.link}
				linkText={textObj?.cards[1]?.linkText}
			/>
			<CardWithHighlightNumber
				kpi={textObj?.cards[2]?.kpi}
				text={textObj?.cards[2]?.text}
				link={textObj?.cards[2]?.link}
				linkText={textObj?.cards[2]?.linkText}
			/>
		</div>
	</div>
</Container>
