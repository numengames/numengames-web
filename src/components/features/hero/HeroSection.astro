---
import HeroContent from "./HeroContent.astro";
import Container from "@components/Container.svelte";
import HeroAnimation from "@components/HeroAnimation.astro";
import Section from "@components/layout/sections/Section.astro";
import PulseAnimatedBtn from "@components/PulseAnimatedBtn.svelte";
import Button from "@components/ui/buttons/Button.astro";
import LocaleSwitcher from "@components/ui/LocaleSwitcher.astro";
import ThemeSwitcher from "@components/ui/ThemeSwitcher.svelte";
import { DEFAULT_LOCALE, type SupportedLocale } from "../../../i18n";
import { getHeroTranslations } from "../../../i18n/translations/hero";

interface Props {
	className?: string;
	locale?: SupportedLocale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

const heroTexts = getHeroTranslations(locale);
const { cta } = heroTexts;
---

<Section>
	{/* Header controls */}
	<!-- <div class="absolute top-4 right-4 z-20 flex items-center space-x-4">
		<ThemeSwitcher client:load />
		<LocaleSwitcher currentLocale={locale} />
	</div> -->

	{/* Desktop version */}
	<div class="hidden xl:block h-full">
		<Container className="h-screen" bgColor="bg-primary-panther">
			<HeroContent layout="desktop" locale={locale} />
		</Container>

		<div class="absolute inset-0 flex justify-center items-center z-10">
			<div class="relative">
				<PulseAnimatedBtn
					className="top-24 3xl:text-xl py-4 px-6 form-toggle-button"
					text={cta}
				/>
			</div>
		</div>
	</div>

	{/* Mobile version */}
	<div class="xl:hidden h-full">
		<Container px="px-4">
			<HeroContent layout="mobile" locale={locale} />
		</Container>

		<div class="absolute inset-0 flex justify-center items-center z-10">
			<div class="relative">
				<PulseAnimatedBtn
					className="top-36 3xl:text-xl py-4 px-6 form-toggle-button"
					text={cta}
				/>
			</div>
		</div>
	</div>

	{/* Common animation component for both versions */}
	<div class="absolute inset-0 flex justify-center items-center w-full h-full">
		<HeroAnimation />
	</div>
</Section>

