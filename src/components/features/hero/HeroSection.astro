---
import HeroContent from "./HeroContent.astro";
import Container from "@components/Container.svelte";
import Section from "@components/layout/sections/Section.astro";
import Viewer3D from "@components/Viewer3D.svelte";
import { DEFAULT_LOCALE, type SupportedLocale } from "../../../i18n";

interface Props {
	className?: string;
	locale?: SupportedLocale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const heroViewerId = "Logo-Khepri-0.1.3-29-10-2024";
---

<Section>
	<div class="relative overflow-hidden bg-primary-panther">
		<div class="hidden xl:block">
			<Container className="h-screen relative" bgColor="bg-primary-panther">
				<div class="relative h-screen">
					<div class="relative z-20 h-full">
						<HeroContent layout="desktop" locale={locale} />
					</div>

					<div class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none">
						<div class="hero-model-desktop">
							<Viewer3D
								client:only="svelte"
								viewerId={heroViewerId}
								isAnimating={true}
							/>
						</div>
					</div>
				</div>
			</Container>
		</div>

		<div class="xl:hidden">
			<Container px="px-4" className="relative min-h-screen" bgColor="bg-primary-panther">
				<div class="relative min-h-screen">
					<div class="relative z-20">
						<HeroContent layout="mobile" locale={locale} />
					</div>

					<div class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none">
						<div class="hero-model-mobile">
							<Viewer3D
								client:only="svelte"
								viewerId={heroViewerId}
								isAnimating={true}
							/>
						</div>
					</div>
				</div>
			</Container>
		</div>
	</div>
</Section>

<style>
	.hero-model-desktop {
		width: min(32vw, 560px);
	}

	.hero-model-mobile {
		width: min(80vw, 360px);
	}

	:global(.hero-model-desktop .viewer-3d),
	:global(.hero-model-mobile .viewer-3d) {
		display: flex !important;
		width: 100%;
		aspect-ratio: 16 / 9;
	}

	@media (max-width: 767px) {
		.hero-model-mobile {
			width: min(88vw, 320px);
		}
	}
</style>
