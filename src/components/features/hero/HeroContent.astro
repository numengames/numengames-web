---
import Heading from "@components/ui/typography/Heading.astro";
import Paragraph from "@components/ui/typography/Paragraph.astro";
import BracketedContent from "@components/BracketedContent.svelte";

import type { ContentSectionProps } from "../../../types";
import { DEFAULT_LOCALE, type SupportedLocale } from "../../../i18n";
import { getHeroTranslations } from "../../../i18n/translations/hero";

interface Props extends ContentSectionProps {
	locale?: SupportedLocale;
}

const { layout = "desktop", className = "", locale = DEFAULT_LOCALE } = Astro.props as Props;

const heroTexts = getHeroTranslations(locale);
const { title, paragraph, technologies, mobileTagline } = heroTexts;
---

{
	layout === "desktop" && (
		<div class={`flex flex-col justify-between w-full pt-36 pb-20 flex-grow z-10 relative h-screen`}>
			<div class="flex justify-between">
				<Heading level={1} className="hero-title" animation={{ type: "fade-right" }}>
					<span>{title.highlight1}</span> <span class="text-[#EFA517]">{title.highlight2}</span>
					<span class="block">
						<span>{title.text1}</span>
					</span>
				</Heading>

				<aside data-aos="fade-left" data-aos-delay="200" class="w-[25%]">
					<BracketedContent text={technologies} isAnimate={true} />
				</aside>
			</div>

			<div class="flex justify-between items-end">
				<Paragraph size="sm 3xl:text-xl 2xl:text-lg" align="justify" className="w-[30vw] 3xl:w-[35vw]" animation={{ type: "fade-right", delay: 400 }}>
					{paragraph.desktop}
				</Paragraph>

				<div>
					<Heading level={2} size="6xl" className="text-right leading-tight" animation={{ type: "fade-left", delay: 600 }}>
						<span>{title.text2}</span>
						<br />
						<span class="text-[#EFA517]">{title.highlight3}</span>
					</Heading>
				</div>
			</div>

			<div class="flex justify-center items-center md:hidden">
				<Paragraph size="[2rem]" fontWeight="font-medium" align="center" className="leading-[2.4rem]">
					{mobileTagline}
				</Paragraph>
			</div>
		</div>
	)
}

{
	layout === "mobile" && (
		<div class={`flex flex-col justify-between items-center w-full pt-28 pb-24 z-10 relative ${className}`}>
			<aside class="w-[60%] mb-3">
				<BracketedContent text={technologies} isAnimate={true} />
			</aside>

			<Heading level={1} size="3xl" align="center" className="px-5 mb-3 z-10">
				<span>{title.highlight1}</span> <span class="text-[#EFA517]">{title.highlight2}</span> <span>{title.text1}</span> <span>{title.text2}</span> <span class="text-[#EFA517]">{title.highlight3}</span>
			</Heading>

			<Paragraph size="sm" align="center" className="z-10">
				{paragraph.mobile}
			</Paragraph>
		</div>
	)
}
