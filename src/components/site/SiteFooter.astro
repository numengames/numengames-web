---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
//
// El pie de página de la casa. Misma forma en numinia.org, numinia.com y
// numen.games: marca + columnas (navegación, legal, social) + la línea de
// cierre — el escarabajo, la firma «by Numen Games — we build for a better
// future.» y la línea de build (licencia · telemetría · versión · commit).
//
// Sin línea de copyright ni «todos los derechos reservados»: este
// repositorio no reserva casi nada. Las licencias van por carpeta y cada
// fichero declara la suya vía REUSE.toml — una reclamación global en el
// pie contradiría el manifiesto (CAN-005 del archivo numinia-nwos).
//
// La firma no se traduce: es voz de marca, la misma frase en los tres
// sitios (decisión del Oráculo, 2026-09-16).
import { getDictionary } from "@content/dictionary";
import { localizedPath, type SupportedLocale } from "@lib/locale";
import { VERSION, COMMIT_SHA, COMMIT_URL, CHANGELOG_URL, LICENSE_URL } from "@lib/build-info";
import { socialLinks } from "@content/social-links";
// El escarabajo cierra la pieza, nunca la abre: su único sitio canónico en
// la web es el pie. Copia local del Khepri_Logo.svg de numinia-web
// (packages/ui/src/assets/brand) mientras no exista un paquete de marca
// instalable; marca reservada, ver REUSE.toml.
import scarab from "@assets/brand/Khepri_Logo.svg?raw";

interface Props {
	locale: SupportedLocale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const f = t.footer;
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__brand">
			<img src="/assets/Letras_Numen_Games_blanco.png" alt="Numen Games" />
			<p>{f.tagline}</p>
			<a href={`mailto:${f.contactEmail}`} class="site-footer__mail">{f.contactEmail}</a>
		</div>

		<nav aria-label={f.navigation}>
			<h2>{f.navigation}</h2>
			<ul>
				{t.nav.links.map((link) => (
					<li>
						<a href={localizedPath(link.path, locale)}>{link.label}</a>
					</li>
				))}
				<li>
					<a href={localizedPath("/contacto", locale)}>{t.nav.ctaPersistent}</a>
				</li>
			</ul>
		</nav>

		<nav aria-label={f.legal}>
			<h2>{f.legal}</h2>
			<ul>
				<li><a href={localizedPath("/legal/terms", locale)}>{f.legalTerms}</a></li>
				<li><a href={localizedPath("/legal/privacy", locale)}>{f.legalPrivacy}</a></li>
			</ul>
		</nav>

		{
			socialLinks.length > 0 && (
				<nav aria-label={f.social}>
					<h2>{f.social}</h2>
					<ul>
						{socialLinks.map((link) => (
							<li>
								<a href={link.href} target="_blank" rel="noopener noreferrer">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}
	</div>

	<div class="site-footer__cierre">
		<span class="site-footer__escarabajo" set:html={scarab} />
		<div class="site-footer__firma">
			<!-- Expresiones explícitas: Astro colapsa el espacio alrededor de
			     elementos en línea y pegaría «by» al enlace. -->
			<p class="site-footer__byline">
				{"by "}<a href="https://numen.games" target="_blank" rel="noopener noreferrer"
					>Numen Games</a
				>{" — we build for a better future."}
			</p>
			<p class="site-footer__build">
				<a href={LICENSE_URL} target="_blank" rel="noopener noreferrer" title={f.licenceTitle}
					>{f.licence}</a
				>
				{" · "}
				<!-- Telemetría: enlace reservado, aún sin destino. La página que
				     mida este sitio (interacción, botones, consentimiento) es una
				     misión aparte; el hueco en el pie es el compromiso. -->
				<a href={localizedPath("/telemetry", locale)} title={f.telemetryTitle}>{f.telemetry}</a>
				{" · "}
				<a href={CHANGELOG_URL} target="_blank" rel="noopener noreferrer" title={f.versionTitle}
					>{VERSION}</a
				>
				{" · "}
				{
					COMMIT_URL ? (
						<a href={COMMIT_URL} target="_blank" rel="noopener noreferrer" title={f.commitTitle}>
							{COMMIT_SHA}
						</a>
					) : (
						<span>{COMMIT_SHA}</span>
					)
				}
			</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
		margin-top: var(--space-24);
		font-size: var(--text-sm);
	}
	.site-footer__inner {
		max-width: var(--content-max);
		margin-inline: auto;
		padding: var(--space-16) var(--gutter-mobile) var(--space-8);
		display: grid;
		gap: var(--space-8);
	}
	.site-footer__brand img {
		height: 22px;
		width: auto;
		opacity: 0.85;
	}
	.site-footer__brand p {
		margin-top: var(--space-3);
		color: var(--ink-faint);
		max-width: 32ch;
	}
	.site-footer__mail {
		display: inline-block;
		margin-top: var(--space-3);
	}
	.site-footer h2 {
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-weight: 500;
		color: var(--accent);
		margin: 0 0 var(--space-3);
	}
	.site-footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.site-footer__inner a {
		color: var(--ink-muted);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.site-footer__inner a:hover,
	.site-footer__inner a:focus-visible {
		color: var(--interactive);
	}

	/* La línea de cierre: filete arriba, escarabajo en tinta apagada junto a
	   la firma y la línea de build. Nunca en color. */
	.site-footer__cierre {
		max-width: var(--content-max);
		margin-inline: auto;
		padding: var(--space-6) var(--gutter-mobile) var(--space-8);
		border-top: 1px solid var(--line);
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}
	.site-footer__escarabajo {
		display: inline-flex;
		color: var(--ink-faint);
		flex: none;
	}
	.site-footer__escarabajo :global(svg) {
		width: 28px;
		height: 28px;
	}
	.site-footer__firma p {
		margin: 0;
		color: var(--ink-faint);
	}
	/* Un enlace dentro de texto corrido no puede depender solo del color
	   (WCAG 1.4.1): subrayado en reposo. */
	.site-footer__byline a {
		color: var(--interactive);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.site-footer__build {
		margin-top: var(--space-2);
		font-size: var(--text-xs);
		font-variant-numeric: tabular-nums;
	}
	.site-footer__build a {
		color: var(--ink-faint);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.site-footer__build a:hover,
	.site-footer__build a:focus-visible {
		color: var(--interactive);
	}

	@media (min-width: 720px) {
		.site-footer__inner {
			grid-template-columns: 2fr 1fr 1fr 1fr;
		}
	}
</style>
