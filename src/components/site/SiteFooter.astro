---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
//
// El pie de página de la casa, la misma forma en los cuatro sitios
// (numinia.org, numinia.com, numen.games, nwos.numen.games — orden del
// Oráculo, 2026-09-16). Su trabajo es reducir incertidumbre: dónde estoy,
// a dónde más puedo ir, qué es esto, qué build estoy leyendo.
//
//   marca + una línea    Navegación     Numen Games       Legal
//                                       (los 4 sitios)    Social
//   ────────────────────────────────────────────────────────────
//   escarabajo  by Numen Games — we build for a better future.
//               licencia · telemetría · versión · commit
//
// Sin línea de copyright: la licencia va por fichero (REUSE.toml). La firma
// es voz de marca y no se traduce.
import { getDictionary } from "@content/dictionary";
import { localizedPath, type SupportedLocale } from "@lib/locale";
import { VERSION, COMMIT_SHA, COMMIT_URL, UPDATES_PATH, LICENSE_URL } from "@lib/build-info";
import { socialLinks } from "@content/social-links";
import { HOUSE_LINKS, THIS_SITE } from "@content/house-links";
// El escarabajo cierra la pieza, nunca la abre: su único sitio canónico en
// la web es el pie. Copia local del Khepri_Logo.svg (marca reservada).
import scarab from "@assets/brand/Khepri_Logo.svg?raw";

interface Props {
	locale: SupportedLocale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const f = t.footer;
const navLinks = [...t.nav.links, { label: t.nav.ctaPersistent, path: "/contacto" }];
const twoColumns = navLinks.length > 4;
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__brand">
			<a href={localizedPath("/", locale)} class="site-footer__name">Numen Games</a>
			<p>{f.tagline}</p>
			<a href={`mailto:${f.contactEmail}`} class="site-footer__mail">{f.contactEmail}</a>
		</div>

		<nav aria-label={f.navigation}>
			<h2>{f.navigation}</h2>
			<ul class:list={[twoColumns && "two"]}>
				{navLinks.map((link) => (
					<li>
						<a href={localizedPath(link.path, locale)}>{link.label}</a>
					</li>
				))}
			</ul>
		</nav>

		<nav aria-label={f.house}>
			<h2>{f.house}</h2>
			<ul>
				{HOUSE_LINKS.map((site) => (
					<li>
						{site.id === THIS_SITE ? (
							<span class="here" aria-current="page">
								{site.label} <small>{f.thisSite}</small>
							</span>
						) : (
							<a href={site.href} target="_blank" rel="noopener noreferrer" title={site.what[locale]}>
								{site.label}
							</a>
						)}
					</li>
				))}
			</ul>
		</nav>

		<div class="site-footer__stack">
			<nav aria-label={f.legal}>
				<h2>{f.legal}</h2>
				<ul>
					<li><a href={localizedPath("/legal/terms", locale)}>{f.legalTerms}</a></li>
					<li><a href={localizedPath("/legal/privacy", locale)}>{f.legalPrivacy}</a></li>
				</ul>
			</nav>
			{
				socialLinks.length > 0 && (
					<nav aria-label={f.social}>
						<h2>{f.social}</h2>
						<ul>
							{socialLinks.map((link) => (
								<li>
									<a href={link.href} target="_blank" rel="noopener noreferrer">
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</div>
	</div>

	<div class="site-footer__cierre">
		<span class="site-footer__escarabajo" set:html={scarab} />
		<div class="site-footer__firma">
			<!-- Expresiones explícitas: Astro colapsa el espacio alrededor de
			     elementos en línea y pegaría «by» al enlace. -->
			<p class="site-footer__byline">
				{"by "}<a href="https://numen.games" target="_blank" rel="noopener noreferrer"
					>Numen Games</a
				>{" — we build for a better future."}
			</p>
			<p class="site-footer__build">
				<a href={LICENSE_URL} target="_blank" rel="noopener noreferrer" title={f.licenceTitle}
					>{f.licence}</a
				>
				{" · "}
				<a href={localizedPath("/telemetry", locale)} title={f.telemetryTitle}>{f.telemetry}</a>
				{" · "}
				<a href={localizedPath(UPDATES_PATH, locale)} class="version" title={f.versionTitle}>{VERSION}</a>
				{" · "}
				{
					COMMIT_URL ? (
						<a href={COMMIT_URL} target="_blank" rel="noopener noreferrer" title={f.commitTitle}>
							{COMMIT_SHA}
						</a>
					) : (
						<span>{COMMIT_SHA}</span>
					)
				}
			</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
		margin-top: var(--space-24);
		font-size: var(--text-sm);
	}
	.site-footer__inner {
		max-width: var(--content-max);
		margin-inline: auto;
		padding: var(--space-16) var(--gutter-mobile) var(--space-8);
		display: grid;
		gap: var(--space-8);
	}
	.site-footer__name {
		font-family: var(--font-titular);
		font-size: var(--text-lg);
		color: var(--ink);
		text-decoration: none;
	}
	.site-footer__brand p {
		margin-top: var(--space-3);
		color: var(--ink-faint);
		max-width: 32ch;
	}
	.site-footer__mail {
		display: inline-block;
		margin-top: var(--space-3);
	}
	.site-footer h2 {
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-weight: 500;
		color: var(--accent);
		margin: 0 0 var(--space-3);
	}
	.site-footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.site-footer ul.two {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-3) var(--space-4);
	}
	.site-footer__stack {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}
	.site-footer__inner a {
		color: var(--ink-muted);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.site-footer__inner a:hover,
	.site-footer__inner a:focus-visible {
		color: var(--interactive);
	}
	.here {
		color: var(--ink);
	}
	.here small {
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--ink-faint);
		margin-left: var(--space-2);
	}

	/* La línea de cierre: filete arriba, escarabajo en tinta apagada junto a
	   la firma y la línea de build. Nunca en color. */
	.site-footer__cierre {
		max-width: var(--content-max);
		margin-inline: auto;
		padding: var(--space-6) var(--gutter-mobile) var(--space-8);
		border-top: 1px solid var(--line);
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}
	.site-footer__escarabajo {
		display: inline-flex;
		color: var(--ink-faint);
		flex: none;
	}
	.site-footer__escarabajo :global(svg) {
		width: 28px;
		height: 28px;
	}
	.site-footer__firma p {
		margin: 0;
		color: var(--ink-faint);
	}
	/* Un enlace dentro de texto corrido no puede depender solo del color
	   (WCAG 1.4.1): subrayado en reposo. */
	.site-footer__byline a {
		color: var(--interactive);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.site-footer__build {
		margin-top: var(--space-2);
		font-size: var(--text-xs);
		font-variant-numeric: tabular-nums;
	}
	.site-footer__build a {
		color: var(--ink-faint);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.site-footer__build a:hover,
	.site-footer__build a:focus-visible {
		color: var(--interactive);
	}
	.site-footer__build .version {
		color: var(--interactive);
		font-weight: 600;
	}

	@media (min-width: 720px) {
		.site-footer__inner {
			grid-template-columns: 1.4fr 1.4fr 1fr 1fr;
		}
	}
</style>
