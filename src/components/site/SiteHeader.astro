---
import { getDictionary } from "@content/dictionary";
import { localizedPath, type SupportedLocale } from "@lib/locale";
// Phosphor regular, from the house subset (MIT, see REUSE.toml).
import moonStars from "@assets/icons/moon-stars.svg?raw";
import sun from "@assets/icons/sun.svg?raw";

interface Props {
	locale: SupportedLocale;
	currentPath: string;
}
const { locale, currentPath } = Astro.props;
const t = getDictionary(locale);
const otherLocale: SupportedLocale = locale === "es" ? "en" : "es";
const menuLabel = locale === "en" ? "Menu" : "Menú";
const modeLabel = locale === "en" ? "Colour mode: day or night" : "Modo de color: día o noche";
---

<header class="site-header">
	<div class="site-header__inner">
		<a href={localizedPath("/", locale)} class="site-header__brand">
			<img src="/assets/Letras_Numen_Games_blanco.png" alt="Numen Games" />
		</a>

		<nav aria-label={locale === "en" ? "Main navigation" : "Navegación principal"} class="site-header__nav">
			<ul>
				{t.nav.links.map((link) => {
					const href = localizedPath(link.path, locale);
					const isActive = currentPath === link.path;
					return (
						<li>
							<a href={href} aria-current={isActive ? "page" : undefined}>
								{link.label}
							</a>
						</li>
					);
				})}
			</ul>
		</nav>

		<div class="site-header__actions">
			<!-- The mode switch (DSN-016): the icon shows where a tap leads —
			     moon with stars to the night, sun to the day. -->
			<button type="button" class="site-header__mode" data-mode-switch aria-label={modeLabel} title={modeLabel}>
				<span class="solo-diurno" set:html={moonStars} />
				<span class="solo-nocturno" set:html={sun} />
			</button>
			<a href={localizedPath(currentPath, otherLocale)} class="site-header__lang" hreflang={otherLocale}>
				{otherLocale.toUpperCase()}
			</a>
			<a href={localizedPath("/contacto", locale)} class="btn btn--accent site-header__cta-desktop">
				{t.nav.ctaPersistent}
			</a>

			<!-- Menú móvil: <details>/<summary> nativo, sin JS, navegable por
			     teclado y lector de pantalla por defecto (plan §8: navegación
			     móvil usable, recorrido con teclado). -->
			<details class="site-header__mobile-menu">
				<summary aria-label={menuLabel}>
					<span class="site-header__burger" aria-hidden="true"></span>
				</summary>
				<div class="site-header__mobile-panel">
					<ul>
						{t.nav.links.map((link) => (
							<li>
								<a href={localizedPath(link.path, locale)}>{link.label}</a>
							</li>
						))}
					</ul>
					<a href={localizedPath("/contacto", locale)} class="btn btn--accent">
						{t.nav.ctaPersistent}
					</a>
				</div>
			</details>
		</div>
	</div>
</header>

<script>
	/* Day and night (DSN-016), numinia.com's switch copied. While the visitor
	   has not chosen, the page follows the device as it changes; a choice ends
	   the following and is remembered under numinia-modo. */
	const root = document.documentElement;
	const apply = (modo: string) => {
		if (modo === "diurno") root.dataset.modo = "diurno";
		else delete root.dataset.modo;
	};
	matchMedia("(prefers-color-scheme: light)").addEventListener("change", (event) => {
		try {
			if (localStorage.getItem("numinia-modo")) return;
		} catch {
			return;
		}
		apply(event.matches ? "diurno" : "nocturno");
	});
	document.querySelector("[data-mode-switch]")?.addEventListener("click", () => {
		const next = root.dataset.modo === "diurno" ? "nocturno" : "diurno";
		apply(next);
		try {
			localStorage.setItem("numinia-modo", next);
		} catch {
			/* private mode: the choice lives for this page only */
		}
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: var(--z-header);
		background: color-mix(in srgb, var(--surface) 92%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
	}
	.site-header__inner {
		max-width: var(--content-max);
		margin-inline: auto;
		padding-inline: var(--gutter-mobile);
		min-height: 72px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-6);
	}
	.site-header__brand img {
		height: 28px;
		width: auto;
		display: block;
	}
	.site-header__nav ul {
		display: none;
		list-style: none;
		margin: 0;
		padding: 0;
		gap: var(--space-6);
	}
	.site-header__nav a {
		color: var(--ink-muted);
		text-decoration: none;
		font-size: var(--text-sm);
		transition: color var(--dur-fast) var(--ease-out);
	}
	.site-header__nav a:hover,
	.site-header__nav a[aria-current="page"] {
		color: var(--ink);
	}
	.site-header__actions {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}
	.site-header__lang {
		color: var(--ink-faint);
		text-decoration: none;
		font-size: var(--text-xs);
		letter-spacing: 0.05em;
	}
	.site-header__lang:hover {
		color: var(--ink);
	}
	.site-header__cta-desktop {
		display: none;
	}
	.site-header__mode {
		width: 44px;
		height: 44px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		background: transparent;
		color: var(--ink-muted);
		border: 1px solid transparent;
		border-radius: var(--radius);
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}
	.site-header__mode:hover {
		color: var(--ink);
		border-color: var(--line-strong);
	}
	.site-header__mode :global(svg) {
		width: 20px;
		height: 20px;
		display: block;
	}
	/* Pure-CSS swap keyed on the html attribute: no flash, no JS paint. */
	:global(html:not([data-modo="diurno"])) .solo-diurno,
	:global(html[data-modo="diurno"]) .solo-nocturno {
		display: none;
	}
	/* The wordmark is a white PNG: on the day paper it is inked dark. */
	:global(html[data-modo="diurno"]) .site-header__brand img {
		filter: brightness(0);
	}

	/* Menú móvil (details/summary nativo) */
	.site-header__mobile-menu {
		position: relative;
	}
	.site-header__mobile-menu summary {
		list-style: none;
		cursor: pointer;
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius);
		border: 1px solid var(--line-strong);
	}
	.site-header__mobile-menu summary::-webkit-details-marker {
		display: none;
	}
	.site-header__mobile-menu summary:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}
	.site-header__burger,
	.site-header__burger::before,
	.site-header__burger::after {
		width: 18px;
		height: 2px;
		background: var(--ink);
		display: block;
		position: relative;
		transition: background var(--dur-fast) var(--ease-out);
	}
	.site-header__burger::before,
	.site-header__burger::after {
		content: "";
		position: absolute;
		left: 0;
	}
	.site-header__burger::before {
		top: -6px;
	}
	.site-header__burger::after {
		top: 6px;
	}
	.site-header__mobile-panel {
		position: absolute;
		top: calc(100% + var(--space-3));
		right: 0;
		background: var(--surface-raised);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: var(--space-4);
		min-width: 220px;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
	}
	.site-header__mobile-panel ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.site-header__mobile-panel a {
		color: var(--ink);
		text-decoration: none;
		font-size: var(--text-base);
	}

	@media (min-width: 960px) {
		.site-header__nav ul {
			display: flex;
		}
		.site-header__cta-desktop {
			display: inline-flex;
		}
		.site-header__mobile-menu {
			display: none;
		}
	}
</style>
