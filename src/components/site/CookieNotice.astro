---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
// The cookie notice (LEG-003 §4): the library's stylesheet dressed in the
// site's own tokens (src/styles/tokens.css), day and night, and one module
// that starts it. The footer's [data-cookie-choice] button reopens it.
import "vanilla-cookieconsent/dist/cookieconsent.css";
---

<script>
	import { startCookieNotice, reopenCookieNotice } from "@lib/cookie-notice";
	startCookieNotice();
	document.querySelectorAll<HTMLElement>("[data-cookie-choice]").forEach((b) => {
		b.addEventListener("click", () => reopenCookieNotice());
	});
</script>

<style is:global>
	#cc-main {
		--cc-font-family: var(--font-cuerpo, inherit);
		--cc-bg: var(--surface-raised);
		--cc-primary-color: var(--ink);
		--cc-secondary-color: var(--ink-muted);
		--cc-link-color: var(--interactive);
		--cc-separator-border-color: var(--line-strong);
		--cc-footer-bg: var(--surface);
		--cc-footer-color: var(--ink-muted);
		--cc-footer-border-color: var(--line-strong);
		--cc-modal-border-radius: var(--radius);
		--cc-btn-border-radius: var(--radius);
		/* Accept and Reject wear the same dress (equal weight). */
		--cc-btn-primary-bg: var(--ink);
		--cc-btn-primary-color: var(--surface);
		--cc-btn-primary-border-color: var(--ink);
		--cc-btn-primary-hover-bg: var(--ink-muted);
		--cc-btn-primary-hover-color: var(--surface);
		--cc-btn-primary-hover-border-color: var(--ink-muted);
		--cc-btn-secondary-bg: var(--surface);
		--cc-btn-secondary-color: var(--ink);
		--cc-btn-secondary-border-color: var(--line-strong);
		--cc-btn-secondary-hover-bg: var(--surface-elevated);
		--cc-btn-secondary-hover-color: var(--ink);
		--cc-btn-secondary-hover-border-color: var(--ink-muted);
		--cc-toggle-readonly-bg: var(--line-strong);
		--cc-toggle-readonly-knob-bg: var(--surface-raised);
		--cc-toggle-readonly-knob-icon-color: var(--ink-muted);
		--cc-cookie-category-block-bg: var(--surface);
		--cc-cookie-category-block-border: var(--line-strong);
		--cc-cookie-category-block-hover-bg: var(--surface-elevated);
		--cc-cookie-category-block-hover-border: var(--line-strong);
		--cc-cookie-category-expanded-block-bg: var(--surface);
		--cc-cookie-category-expanded-block-hover-bg: var(--surface-elevated);
		--cc-overlay-bg: rgba(0, 0, 0, 0.6);
	}
	#cc-main a {
		text-decoration: underline;
	}
	/* 44 px touch targets, the house minimum for main controls. */
	#cc-main .cm__btn,
	#cc-main .pm__btn {
		min-height: 44px;
	}
	/* Accept all and Reject all side by side, also on phones: the library's
	   own mobile rule stacks them (flex-direction: column !important); this
	   more specific rule keeps them in one row, same width. */
	#cc-main .cm .cm__btn-group {
		flex-direction: row !important;
		gap: 0.375rem;
	}
	#cc-main .cm .cm__btn-group .cm__btn {
		flex: 1 1 0 !important;
		margin: 0 !important;
	}
</style>
