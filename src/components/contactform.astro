---
import PulseAnimatedBtn from "@components/PulseAnimatedBtn.svelte";
---

<form
	action="https://api.web3forms.com/submit"
	method="POST"
	id="form"
	class="space-y-5"
	novalidate
>
	<input
		type="hidden"
		name="access_key"
		value="fca434f5-b15d-49d6-90e5-047ac677fbc4"
	/>
	<input type="checkbox" class="hidden" style="display:none" name="botcheck" />

	<!-- First Name and Last Name -->
	<div class="flex space-x-4">
		<div class="w-full">
			<label for="first-name" class="block text-xl text-primary-beige mb-4">
				First Name
			</label>
			<input
				required
				type="text"
				id="first-name"
				name="first-name"
				placeholder="First name"
				class="w-full py-5 px-6 rounded-lg border text-primary-beige outline-none bg-white/5 border-white/10 font-light text-xl"
			/>
		</div>

		<div class="w-full">
			<label for="last-name" class="block text-xl text-primary-beige mb-4">
				Last Name
			</label>
			<input
				required
				type="text"
				id="last-name"
				name="last-name"
				placeholder="Last name"
				class="w-full py-5 px-6 rounded-lg border text-primary-beige outline-none bg-white/5 border-white/10 font-light text-xl"
			/>
		</div>
	</div>

	<!-- Email -->
	<div class="w-full">
		<label for="email-address" class="block text-xl text-primary-beige mb-4">
			Work Email
		</label>
		<input
			required
			type="email"
			id="email-address"
			name="email-address"
			placeholder="Email Address"
			class="w-full py-5 px-6 rounded-lg border text-primary-beige outline-none bg-white/5 border-white/10 font-light text-xl"
		/>
	</div>

	<!-- Project Description -->
	<div>
		<label for="project-description" class="block text-xl text-primary-beige mb-4">
			What do you want to build?
		</label>
		<textarea
			required
			name="project-description"
			placeholder="Tell us more about your project..."
			class="w-full px-4 py-3 border-2 font-light text-xl rounded-md outline-none h-36 bg-white/5 border-white/10 text-primary-beige"
		></textarea>
	</div>

	<!-- Terms -->
	<div class="flex items-center space-x-2 mt-6 text-lg">
		<input
			type="checkbox"
			name="terms"
			id="terms"
			class="h-5 w-5 text-primary-coralRed"
			required
		/>
		<label for="terms" class="font-light text-primary-beige">
			I agree to Numen Games
			<a
				href="/Term/terms"
				class="text-primary-coralRed underline open-terms"
			>
				Terms and Conditions
			</a>
		</label>
	</div>

	<!-- Submit Button -->
	<PulseAnimatedBtn
		className="text-[1.2rem] text-primary-beige"
		text="Submit"
	/>

	<div id="result" class="mt-3 text-center"></div>
</form>

<script is:inline>
	const form = document.getElementById("form");
	const result = document.getElementById("result");

	form.addEventListener("submit", async (e) => {
		e.preventDefault();

		// Native validation (includes checkbox)
		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		const formData = new FormData(form);
		const object = Object.fromEntries(formData);
		const json = JSON.stringify(object);

		result.innerHTML = "Sending...";

		try {
			const response = await fetch("https://api.web3forms.com/submit", {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
					Accept: "application/json",
				},
				body: json,
			});

			const data = await response.json();

			if (response.status === 200) {
				result.className = "text-green-500";
				result.innerHTML = data.message;
			} else {
				result.className = "text-red-500";
				result.innerHTML = data.message;
			}
		} catch (error) {
			result.className = "text-red-500";
			result.innerHTML = "Something went wrong.";
		}
	});
</script>
