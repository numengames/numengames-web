---
import PulseAnimatedBtn from "@components/PulseAnimatedBtn.svelte";
import { getContactTranslations } from "../i18n/translations/contact";
import type { SupportedLocale } from "../i18n";

interface Props {
	locale?: SupportedLocale;
}

const { locale = "en" } = Astro.props;
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
const t = getContactTranslations(locale);
---

<form action="https://api.web3forms.com/submit" method="POST" id="form" class="flex flex-col gap-7" novalidate>
	<input type="hidden" name="access_key" value={web3FormsKey} />
	<input type="checkbox" class="hidden" style="display:none" name="botcheck" />

	<!-- First Name and Last Name -->
	<div class="grid grid-cols-2 gap-6">
		<div class="contact-field">
			<label for="first-name">{t.firstName}</label>
			<input required type="text" id="first-name" name="first-name" placeholder="Jane" />
			<span class="contact-field__line"></span>
		</div>
		<div class="contact-field">
			<label for="last-name">{t.lastName}</label>
			<input required type="text" id="last-name" name="last-name" placeholder="Smith" />
			<span class="contact-field__line"></span>
		</div>
	</div>

	<!-- Email -->
	<div class="contact-field">
		<label for="email-address">{t.email}</label>
		<input required type="email" id="email-address" name="email-address" placeholder="jane@company.com" />
		<span class="contact-field__line"></span>
	</div>

	<!-- Project Description -->
	<div class="contact-field">
		<label for="project-description">{t.project}</label>
		<textarea required id="project-description" name="project-description" placeholder={t.projectPlaceholder} rows="4"></textarea>
		<span class="contact-field__line"></span>
	</div>

	<!-- Terms -->
	<div class="flex items-start gap-3 mt-1">
		<input type="checkbox" name="terms" id="terms" class="mt-0.5 h-4 w-4 shrink-0 accent-[#EFA517] cursor-pointer" required />
		<label for="terms" class="text-sm font-light text-arena/50 leading-relaxed cursor-pointer">
			{t.terms}
			<a href="/Term/terms" class="text-[#EFA517] hover:text-[#F9EBDC] transition-colors underline-offset-2 underline open-terms">
				{t.termsLink}
			</a>
		</label>
	</div>

	<!-- Submit -->
	<div class="mt-2">
		<PulseAnimatedBtn className="text-base text-arena" text={t.send} client:load />
	</div>

	<div id="result" class="mt-2 text-sm text-center"></div>
</form>

<style>
	.contact-field {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.contact-field label {
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(239, 165, 23, 0.7);
	}

	.contact-field input,
	.contact-field textarea {
		background: transparent;
		border: none;
		border-bottom: 1px solid rgba(249, 235, 220, 0.12);
		border-radius: 0;
		padding: 0.5rem 0 0.75rem;
		color: rgba(249, 235, 220, 0.9);
		font-size: 0.95rem;
		font-weight: 300;
		outline: none;
		width: 100%;
		transition: border-color 0.25s ease;
		resize: none;
	}

	.contact-field input::placeholder,
	.contact-field textarea::placeholder {
		color: rgba(249, 235, 220, 0.2);
	}

	.contact-field input:focus,
	.contact-field textarea:focus {
		border-bottom-color: #efa517;
	}

	.contact-field__line {
		display: none;
	}
</style>

<script is:inline define:vars={{ sending: t.sending, errorMsg: t.error }}>
	const form = document.getElementById("form");
	const result = document.getElementById("result");

	form.addEventListener("submit", async (e) => {
		e.preventDefault();

		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		const formData = new FormData(form);
		const object = Object.fromEntries(formData);
		const json = JSON.stringify(object);

		result.innerHTML = sending;
		result.className = "mt-2 text-sm text-center text-arena/50";

		try {
			const response = await fetch("https://api.web3forms.com/submit", {
				method: "POST",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: json,
			});

			const data = await response.json();

			if (response.status === 200) {
				result.className = "mt-2 text-sm text-center text-verdemar";
				result.innerHTML = data.message;
			} else {
				result.className = "mt-2 text-sm text-center text-coral";
				result.innerHTML = data.message;
			}
		} catch {
			result.className = "mt-2 text-sm text-center text-coral";
			result.innerHTML = errorMsg;
		}
	});
</script>
