---
import { Icon } from "astro-icon/components";

import Container from "@components/Container.svelte";
---

<Container className="py-8 sm:py-12 md:py-16">
	<div
		class="flex flex-col justify-center items-center text-center px-4 sm:px-6 lg:px-12">
		<h3
			class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4 sm:mb-6 lg:mb-8">
			Custom Scenario Settings
		</h3>
		<p class="text-center text-base sm:text-lg md:text-xl lg:text-2xl font-medium mt-2 sm:mt-4 max-w-3xl">
			A tailored set of requirements crafted to perfectly align with your
			specific goals and objectives.
		</p>
	</div>
	<div
		class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 pt-8 sm:pt-12 md:pt-16 pb-8 sm:pb-12 md:pb-16 px-4 sm:px-6 lg:px-12">
		<div class="flex flex-col items-center text-center p-4 sm:p-6 hover:scale-[1.02] transition-transform duration-300">
			<Icon
				class="h-16 w-16 sm:h-20 sm:w-20 lg:h-24 lg:w-24 mb-4 sm:mb-6"
				name="learn"
			/>
			<h4 class="font-bold text-lg sm:text-xl lg:text-2xl mb-2 sm:mb-3">Learn</h4>
			<p class="text-base sm:text-lg text-slate-500 max-w-md">
				Gain insights and knowledge through engaging, interactive learning
				experiences.
			</p>
		</div>
		<div class="flex flex-col items-center text-center p-4 sm:p-6 hover:scale-[1.02] transition-transform duration-300">
			<Icon
				class="h-16 w-16 sm:h-20 sm:w-20 lg:h-24 lg:w-24 mb-4 sm:mb-6"
				name="build"
			/>
			<h4 class="font-bold text-lg sm:text-xl lg:text-2xl mb-2 sm:mb-3">Build</h4>
			<p class="text-base sm:text-lg text-slate-500 max-w-md">
				Explore our extensive range of ready-to-use gamified simulations, with
				customization options for a truly tailored experience, designed to
				captivate and deliver impactful results.
			</p>
		</div>
	</div>
</Container>
