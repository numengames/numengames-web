---
import { Icon } from "astro-icon/components";
import { getLocaleFromURL, DEFAULT_LOCALE, type SupportedLocale } from "../i18n/index";

import PulseAnimatedBtn from "@components/PulseAnimatedBtn.svelte";

// Get current locale from URL or use default
const currentLocale = getLocaleFromURL(Astro.url.pathname) || DEFAULT_LOCALE;

// Helper function to get localized path
const getLocalizedPath = (path: string) => `/${currentLocale}${path.startsWith('/') ? path : `/${path}`}`;

---

<footer class="flex flex-col bg-[#171717] pt-24 pb-6 px-10 md:px-10 px-6">
	<section
		class="flex md:h-[495px] h-auto bg-custom-gradient rounded-lg relative d-image mb-10">
		<div
			class="md:w-1/2 w-full flex items-center justify-center pr-0 pt-10 pb-10 md:pl-10 pl-5 h-full md:ml-auto z-20">
			<div class="text-primary-beige text-left">
				<h2 class="md:text-h2 text-2xl font-medium md:mb-8 mb-5 md:mr-24 mr-0" style="md:line-height: 57.6px; line-height: normal;">
					Start creating your own
					<span class="text-primary-coralRed">3D immersive</span>
					experience with us now!
				</h2>
				<div class="flex md:flex-row flex-col text-base">
					<PulseAnimatedBtn
						className="md:mr-9 mr-0 md:mb-0 mb-4 form-toggle-button text-primary-beige"
						text="Ready to talk?"
					/>
					<a
						href="https://v2.oncyber.io/age_of_ai"
						class="text-primary-beige py-3 px-7 rounded-lg hover:bg-opacity-90 transition-all text-center"
						style="border: 1px solid #FFFFFF4D;">
						Try a demo
					</a>
				</div>
			</div>
		</div>
	</section>
	<section class="flex md:flex-row flex-col items-start justify-between mb-10">
		<div class="flex flex-col justify-between text-primary-beige md:h-44 mb-10 md:mb-0">
			<img
				src="/assets/numen-logo.svg"
				alt="Numen Logo"
				loading="lazy"
				class="md:w-[44vw] w-[200px] h-auto"
			/>
			<div class="flex flex-row space-x-4 mt-5 md:mt-0">
				<a
					href="https://x.com/numinia_xyz"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center justify-center h-10 w-10 rounded-full bg-white/10">
					<Icon class="h-6 w-6" name="x-logo" style="fill: white;" />
				</a>
				<a
					href="https://www.linkedin.com/company/numengamessl/"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center justify-center h-10 w-10 rounded-full bg-white/10">
					<Icon class="h-6 w-6" name="linkedin-logo" style="fill: white;" />
				</a>
				<a
					href="https://discord.gg/ASwwdd24pp"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center justify-center h-10 w-10 rounded-full bg-white/10">
					<Icon class="h-6 w-6" name="discord-logo" style="fill: white;" />
				</a>
				<a
					href="https://github.com/numengames"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center justify-center h-10 w-10 rounded-full bg-white/10">
					<Icon class="h-6 w-6" name="github-logo" style="fill: white;" />
				</a>
			</div>
		</div>
		<div class="flex md:flex-row flex-col md:justify-end md:space-x-28 space-x-0 md:space-y-0 space-y-8 w-full md:w-auto">
			<section class="flex flex-col text-primary-beige font-extralight">
				<h3 class="mb-6">Services</h3>
				<ul class="space-y-3 text-primary-beige/75">
					<li><a href={getLocalizedPath("/services/engage")}>Engage</a></li>
					<li>
						<a href={getLocalizedPath("/services/training")}>Training</a>
					</li>
					<li>
						<a href={getLocalizedPath("/services/experience")}>Experience</a>
					</li>
				</ul>
			</section>
			<section class="flex flex-col text-primary-beige font-extralight">
				<h3 class="mb-6">Company</h3>
				<ul class="space-y-3 text-primary-beige/75">
					<li><a href={getLocalizedPath("/team")}>About us</a></li>
					<li>
						<button class="form-toggle-button">Contact us</button>
					</li>
					<li>
						<a href={getLocalizedPath("/manifesto")}>Manifesto</a>
					</li>
					<!-- <li><a href="/blog">Blog</a></li> -->
				</ul>
			</section>
			<section class="flex flex-col text-primary-beige font-extralight">
				<h3 class="mb-6">Other</h3>
				<ul class="space-y-3 text-primary-beige/75">
					<li>
						<a href="/help-center">Help center</a>
					</li>
					<li><a href="/numinia">Numinia</a></li>
					<li>
						<a target="_blank" href="https://docs.numen.games/docs/intro"
							>Documentation</a
						>
					</li>
				</ul>
			</section>
		</div>
	</section>
	<hr class="border border-solid border-[#262626]" />
	<section
		class="flex md:flex-row flex-col justify-between w-full text-primary-beige/50 text-sm font-extralight mt-3 md:space-y-0 space-y-3">
		<p>Made with love by the Numen Games team</p>
		<ul class="flex md:flex-row flex-col md:space-y-0 space-y-2">
			<li class="md:mr-4 mr-0">
				<a target="_blank"
				href="https://statics.numinia.xyz/terms_and_conditions_2024_05_09.pdf">Privacy policy</a>
			</li>
			<li class="md:mr-4 mr-0">
				<a
					target="_blank"
					href="https://statics.numinia.xyz/terms_and_conditions_2024_05_09.pdf"
					>Terms & Conditions</a
				>
			</li>
			<li>
				<a target="_blank"
				href="https://statics.numinia.xyz/cookies-policy-2024-05-09.pdf">Cookies</a>
			</li>
		</ul>
	</section>
</footer>

<style>
	.bg-custom-gradient {
		background: linear-gradient(
			to bottom right,
			rgba(1, 142, 161, 0.2) 10%,
			rgba(211, 52, 64, 0.1) 40%,
			rgba(33, 33, 35, 0.9) 70%
		);
	}
	.d-image::after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		background-repeat: no-repeat;
		height: 100%;
		background-image: url("/assets/footer-img.png");
		background-size: contain;
		background-position: left;
		z-index: 1;
	}

	@media (max-width: 768px) {
		.d-image::after {
			opacity: 0.4;
			background-position: center;
		}
	}
</style>
