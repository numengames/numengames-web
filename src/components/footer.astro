---
import { Icon } from "astro-icon/components";
import { getLocaleFromURL, DEFAULT_LOCALE } from "../i18n/index";
import PulseAnimatedBtn from "@components/PulseAnimatedBtn.svelte";

const currentLocale = getLocaleFromURL(Astro.url.pathname) || DEFAULT_LOCALE;
const getLocalizedPath = (path: string) => `/${currentLocale}${path.startsWith("/") ? path : `/${path}`}`;
---

<footer class="bg-[#171717] px-4 sm:px-6 md:px-10 pt-12 sm:pt-14 md:pt-16 pb-6">

	<section class="mb-10 rounded-2xl border border-[rgba(217,184,106,0.12)] bg-[linear-gradient(135deg,rgba(44,36,22,0.92),rgba(19,22,26,0.96),rgba(24,20,16,0.96))]">
		<div class="px-6 py-8 sm:px-8 sm:py-10 md:px-10 md:py-12">

			<div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-8 lg:gap-10 items-center">

				<div class="text-primary-beige max-w-4xl">
					<h2 class="text-2xl sm:text-3xl md:text-5xl font-medium leading-tight">
						Start creating your own
						<span class="text-[#D9B86A]">3D immersive experience</span>
						with us now
					</h2>

					<p class="mt-5 text-primary-beige/70 text-sm sm:text-base md:text-lg max-w-3xl">
						We design interactive digital products focused on learning, engagement and branded experiences.
					</p>
				</div>

				<div class="flex items-center justify-center">
					<PulseAnimatedBtn
						className="text-white px-14 py-3 min-w-[240px] justify-center form-toggle-button"
						text="Contact"
					/>
				</div>

			</div>

		</div>
	</section>


	<section class="grid grid-cols-1 xl:grid-cols-[auto_1fr_auto] gap-10 items-start mb-8">

		<div class="flex flex-col text-primary-beige">
			<img
				src="/assets/Letras_Numen_Games_blanco.png"
				alt="Numen Games"
				loading="lazy"
				class="w-[180px] sm:w-[220px] md:w-[300px] lg:w-[420px] h-auto"
			/>
		</div>

		<div class="xl:flex items-center justify-center self-center">
			<div class="flex items-center gap-3 mt-3 xl:mt-0">
				<a
					href="https://x.com/numinia_xyz"
					target="_blank"
					rel="noopener noreferrer"
					class="footer-social-link">
					<Icon class="h-5 w-5" name="x-logo" />
				</a>
				<a
					href="https://www.linkedin.com/company/numengamessl/"
					target="_blank"
					rel="noopener noreferrer"
					class="footer-social-link">
					<Icon class="h-5 w-5" name="linkedin-logo" />
				</a>
				<a
					href="https://discord.gg/ASwwdd24pp"
					target="_blank"
					rel="noopener noreferrer"
					class="footer-social-link">
					<Icon class="h-5 w-5" name="discord-logo" />
				</a>
				<a
					href="https://github.com/numengames"
					target="_blank"
					rel="noopener noreferrer"
					class="footer-social-link">
					<Icon class="h-5 w-5" name="github-logo" />
				</a>
			</div>
		</div>

		<div class="w-full xl:w-auto">
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-12 lg:gap-16 text-primary-beige">

				<section class="flex flex-col">
					<h3 class="mb-4 text-lg sm:text-xl">Services</h3>
					<ul class="space-y-3 text-primary-beige/75">
						<li><a href={getLocalizedPath("/services/engage")} class="hover:text-[#D9B86A] transition-colors">Engage</a></li>
						<li><a href={getLocalizedPath("/services/training")} class="hover:text-[#D9B86A] transition-colors">Training</a></li>
						<li><a href={getLocalizedPath("/services/experience")} class="hover:text-[#D9B86A] transition-colors">Experience</a></li>
					</ul>
				</section>

				<section class="flex flex-col">
					<h3 class="mb-4 text-lg sm:text-xl">Company</h3>
					<ul class="space-y-3 text-primary-beige/75">
						<li><a href={getLocalizedPath("/team")} class="hover:text-[#D9B86A] transition-colors">About us</a></li>
						<li><button class="form-toggle-button hover:text-[#D9B86A] transition-colors text-left">Contact</button></li>
						<li><a href={getLocalizedPath("/manifesto")} class="hover:text-[#D9B86A] transition-colors">Manifesto</a></li>
						<li><a href={getLocalizedPath("/portfolio")} class="hover:text-[#D9B86A] transition-colors">Portfolio</a></li>
					</ul>
				</section>

				<section class="flex flex-col">
					<h3 class="mb-4 text-lg sm:text-xl">Resources</h3>
					<ul class="space-y-3 text-primary-beige/75">
						<li><a href={getLocalizedPath("/help-center")} class="hover:text-[#D9B86A] transition-colors">Help center</a></li>
						<li><a href={getLocalizedPath("/numinia")} class="hover:text-[#D9B86A] transition-colors">Numinia</a></li>
						<li><a target="_blank" href="https://docs.numen.games/docs/intro" class="hover:text-[#D9B86A] transition-colors">Documentation</a></li>
					</ul>
				</section>

			</div>
		</div>

	</section>


	<section class="pt-5 border-t border-[rgba(217,184,106,0.08)] flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-sm text-primary-beige/50">

		<p>Made by the Numen Games team</p>

		<div class="flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-5 md:ml-auto">
			<a
				href="https://www.enisa.es/"
				target="_blank"
				rel="noopener noreferrer"
				class="opacity-90 hover:opacity-100 transition-opacity shrink-0">
				<img
					src="/assets/enisa-logo.png"
					alt="ENISA"
					class="h-7 w-auto shrink-0 object-contain"
				/>
			</a>

			<button class="open-privacy hover:text-[#D9B86A] transition-colors cursor-pointer">Privacy policy</button>
			<button class="open-terms hover:text-[#D9B86A] transition-colors cursor-pointer">Terms & Conditions</button>
			<button class="open-cookies hover:text-[#D9B86A] transition-colors cursor-pointer">Cookies</button>
		</div>

	</section>

</footer>

<style is:global>
	.footer-social-link {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 2.5rem;
		width: 2.5rem;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #D9B86A;
		transition: all 0.2s;
	}

	.footer-social-link:hover {
		background: rgba(217, 184, 106, 0.1);
		border-color: rgba(217, 184, 106, 0.4);
	}
</style>
