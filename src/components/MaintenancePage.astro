---
// Maintenance Page Component
// Displays during v2.0 development
---

<div class="maintenance-container">
  <div class="maintenance-content">
    <img 
      src="/assets/Logo_Khepri_Web.png" 
      alt="Khepri Logo" 
      class="khepri-logo"
    />
    <img 
      src="/assets/numen-logo.svg" 
      alt="Numen Logo" 
      class="maintenance-logo"
    />
    <p class="maintenance-text">Coming Soon</p>
  </div>
</div>

<style>
  .maintenance-container {
    width: 100%;
    height: 100vh;
    background-color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
  }

  .maintenance-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .khepri-logo {
    max-width: 120px;
    width: 100%;
    height: auto;
  }

  .maintenance-logo {
    max-width: 200px;
    width: 100%;
    height: auto;
    filter: brightness(0) invert(1);
  }

  .maintenance-text {
    color: #ffffff;
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: 0.15em;
    margin: 0;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .khepri-logo {
      max-width: 90px;
    }

    .maintenance-logo {
      max-width: 150px;
    }

    .maintenance-text {
      font-size: 1.2rem;
    }
  }
</style>
