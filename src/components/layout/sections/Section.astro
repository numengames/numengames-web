---
import type { SectionProps } from "../../../types";

const { id, className = "", bgColor = "bg-nocturno-base", height = "h-screen", fullWidth = false } = Astro.props as SectionProps;
---

<section id={id} class:list={[bgColor, height, "relative", fullWidth ? "w-full" : "max-w-[1920px] mx-auto", className]}>
	<slot />
</section>
