---
import type { AnimationProps, TailwindColors, TailwindAlignments, TailwindSizes } from "../../../types";

export interface ParagraphProps {
  size?: TailwindSizes;
  color?: TailwindColors;
  fontWeight?: string;
  align?: TailwindAlignments;
  className?: string;
  animation?: AnimationProps;
}

const { 
  size = "base", 
  color = "primary-beige/75", 
  fontWeight = "font-[84]", 
  align = "left",
  className = "",
  animation
} = Astro.props as ParagraphProps;

const animationAttrs = animation ? {
  "data-aos": animation.type,
  "data-aos-delay": animation.delay || 0
} : {};
---

<p 
  class:list={[
    `text-${size}`,
    `text-${align}`,
    `text-${color}`,
    fontWeight,
    className
  ]}
  {...animationAttrs}
>
  <slot />
</p> 