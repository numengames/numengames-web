---
export type ButtonVariant = "primary" | "secondary" | "outline" | "ghost";
export type ButtonSize = "xs" | "sm" | "md" | "lg";

export interface ButtonProps {
	text: string;
	variant?: ButtonVariant;
	size?: ButtonSize;
	className?: string;
	href?: string;
	isForm?: boolean;
}

const { text, variant = "outline", size = "md", className = "", href, isForm = false } = Astro.props as ButtonProps;

const commonClasses = `
  rounded-control
  text-arena
  ${size === "xs" ? "text-xs py-2 px-4" : ""}
  ${size === "sm" ? "text-sm py-2 px-5" : ""}
  ${size === "md" ? "text-base py-3 px-6" : ""}
  ${size === "lg" ? "text-lg py-4 px-8" : ""}
  ${variant === "primary" ? "bg-interactivo hover:bg-interactivo-hover active:bg-interactivo-activo" : ""}
  ${variant === "secondary" ? "bg-nocturno-base hover:bg-nocturno-base/90" : ""}
  ${variant === "outline" ? "border border-interactivo hover:bg-interactivo/10" : ""}
  ${variant === "ghost" ? "hover:bg-nocturno-base/10" : ""}
  ${isForm ? "form-toggle-button" : ""}
  ${className}
`;

// Special styles for outline variant
const outlineStyles = variant === "outline" ? 'style="box-shadow: 0 0 12px rgba(239, 165, 23, 0.25);"' : "";
---

{
	href ? (
		<a href={href} class={commonClasses} {...(outlineStyles && { style: outlineStyles })}>
			<slot name="prefix" />
			{text}
			<slot name="suffix" />
		</a>
	) : (
		<button class={commonClasses} {...(outlineStyles && { style: outlineStyles })}>
			<slot name="prefix" />
			{text}
			<slot name="suffix" />
		</button>
	)
}
