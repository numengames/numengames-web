---
export type ButtonVariant = 'primary' | 'secondary' | 'outline' | 'ghost';
export type ButtonSize = 'xs' | 'sm' | 'md' | 'lg';

export interface ButtonProps {
  text: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  className?: string;
  href?: string;
  isForm?: boolean;
}

const {
  text,
  size = 'md',
  className = "",
  href,
  isForm = false
} = Astro.props as ButtonProps;

const commonClasses = `
  btn-pricing
  flex items-center justify-center gap-2
  ${size === 'xs' ? 'text-xs py-2 px-4' : ''}
  ${size === 'sm' ? 'text-sm py-2 px-5' : ''}
  ${size === 'md' ? 'text-base py-3 px-6' : ''}
  ${size === 'lg' ? 'text-lg py-4 px-8' : ''}
  ${isForm ? 'form-toggle-button' : ''}
  ${className}
`;
---

{href ? (
  <a href={href} class={commonClasses}>
    <slot name="prefix" />
    {text}
    <slot name="suffix" />
  </a>
) : (
  <button class={commonClasses}>
    <slot name="prefix" />
    {text}
    <slot name="suffix" />
  </button>
)}

<style>
  :global(.btn-pricing) {
    background: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 0.75rem;
    color: white;
    box-shadow: 0 0 20px 3px rgba(217, 184, 106, 0.35);
    transition: all 0.3s;
  }
  :global(.btn-pricing:hover) {
    box-shadow: 0 0 30px 6px rgba(217, 184, 106, 0.75);
  }
</style>
