---
import { Icon } from "astro-icon/components";
import Container from "@components/Container.svelte";

const features = [
	{
		title: "Cosmic Harmony",
		description:
			"Numinians serve and balance life, guided by actions with purpose, ensuring prosperity for all.",
		icon: "cosmic-harmony",
	},
	{
		title: "Equable",
		description:
			"For Numinians fairness shapes every decision, fostering reality, unity, and constructive honesty.",
		icon: "equable",
	},
	{
		title: "Curiosity",
		description:
			"Numinians like to be selfaware, actively inferring to minimize the surprise, exploring beyond the familiar territories, we learn by doing.",
		icon: "curiosity",
	},
	{
		title: "Healthy Enviroments",
		description:
			"Numinians forge enduring relations and creations, nurturing the public good; Sustainability guides our steps.",
		icon: "healty-environment",
	},
];
---

<Container
	class="grid lg:grid-cols-1 place-items-center py-8 sm:py-12 md:py-16 text-justify">
	<h3 class="text-center text-3xl sm:text-4xl lg:text-5xl font-bold lg:tracking-tight">
		Values and Principles
	</h3>
	<p
		class="text-center text-base sm:text-lg md:text-xl lg:text-2xl mt-6 sm:mt-8 md:mt-10 text-slate-600 max-w-3xl mx-auto px-4">
		We champion this values, to craft a gaming experience that's not only
		sustainable but deeply connects and resonates with our users.
	</p>

	<div class="grid sm:grid-cols-2 gap-8 sm:gap-12 mt-12 sm:mt-16 px-4 sm:px-6 lg:px-12">
		{
			features.map((item) => (
				<div class="flex gap-4 items-start p-4 sm:p-6 hover:scale-[1.02] transition-transform duration-300">
					<div class="mt-1 bg-black rounded-full p-2 w-12 h-12 sm:w-14 sm:h-14 shrink-0">
						<Icon class="text-white w-8 h-8 sm:w-10 sm:h-10" name={item.icon} />
					</div>
					<div>
						<h3 class="font-semibold text-lg sm:text-xl">{item.title}</h3>
						<p class="text-slate-500 mt-2 leading-relaxed text-sm sm:text-base">
							{item.description}
						</p>
					</div>
				</div>
			))
		}
	</div>
</Container>
