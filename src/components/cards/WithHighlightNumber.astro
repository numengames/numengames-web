---
const { kpi, text, link, linkText } = Astro.props;
---

<div
	class="card border p-4 md:p-6 lg:p-10 border-white/10 rounded-xl aspect-[1.115625] flex flex-col justify-between relative after:content-[''] after:bg-[url('/assets/gradientOverlayCard.svg')] after:absolute after:top-0 after:right-0 after:w-full after:h-full after:bg-center after:bg-cover after:bg-no-repeat transition-all duration-300">
	<p class="text-primary-coralRed text-4xl md:text-5xl lg:text-6xl font-medium">{kpi}</p>
	<div class="z-10">
		<p class="text-primary-beige/75 font-extralight opacity-80 mb-2 text-sm md:text-base">{text}</p>
		<a
			class="text-primary-coralRed/75 font-extralight opacity-80 cursor-pointer text-xs md:text-sm"
			href={link}
			target="_blank">
			Source: {linkText}
		</a>
	</div>
</div>

<style>
	.card {
		box-shadow: 0px 0px 30px 0px rgba(255, 255, 255, 0.20) inset;
	}

	.card:hover {
		box-shadow:
			0 0 25px 4px rgba(217, 184, 106, 0.45),
			0 0 10px rgba(217, 184, 106, 0.25),
			0 0 4px rgba(217, 184, 106, 0.15);
		transform: translateY(-2px);
		border-color: rgba(217, 184, 106, 0.35);
	}
</style>
