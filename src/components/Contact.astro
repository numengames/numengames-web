---
import { Icon } from "astro-icon/components";

import Contactform from "@components/contactform.astro";

import Logo from "./navbar/Logo.astro";
---

<div class="fixed inset-0 bg-black/50 hidden z-40" id="contactOverlay"></div>
<div
	class="fixed hidden w-[95%] md:w-[calc(100%-80px)] h-[90%] md:h-[calc(100%-80px)] top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-primary-panther rounded-xl z-50 overflow-y-auto"
	id="contactFormContainer">
	<div class="flex flex-col h-full">
		<div class="m-4 md:m-10 flex justify-between">
			<Logo />
			<div
				class="flex items-center justify-center bg-white/10 border rounded-full border-white/20 p-1 cursor-pointer form-toggle-button">
				<Icon class="text-white h-6 w-6" name="x" />
			</div>
		</div>
		<div class="flex flex-col md:flex-row justify-between mx-4 md:mx-10 gap-8 md:gap-16">
			<iframe
				src="https://app.spline.design/file/c9b86da0-7c77-4710-9e84-04d7cc6ae33c?view=preview&fullscreen=false"
				class="object-cover relative border border-primary-beige/70 rounded-xl shadow-[0px_0px_40px_0px_#FFFFFF66] w-full md:w-[50%] h-[300px] md:h-auto"
			></iframe>
			<div class="w-full md:w-[50%]">
				<h3 class="text-2xl md:text-4xl font-medium tracking-[-0.03em] text-primary-beige">
					Turn your vision into reality
				</h3>
				<p class="text-base md:text-lg font-light text-primary-beige/75 md:pr-20">
					Tell us about your project and we'll help you find the right match.
				</p>
				<Contactform />
			</div>
		</div>
	</div>
</div>

<script>
	document.addEventListener("click", ({ target }) => {
		const contactFormContainer = document.getElementById("contactFormContainer");
		const contactOverlay = document.getElementById("contactOverlay");
		
		if (contactFormContainer && contactOverlay) {
			if (target instanceof Element && target.closest(".form-toggle-button")) {
				contactFormContainer.classList.toggle("hidden");
				contactOverlay.classList.toggle("hidden");
			} else if (!contactFormContainer.contains(target)) {
				contactFormContainer.classList.add("hidden");
				contactOverlay.classList.add("hidden");
			}
		}
	});
</script>
