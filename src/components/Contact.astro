---
import { Icon } from "astro-icon/components";
import Contactform from "@components/contactform.astro";
import Logo from "./navbar/Logo.astro";
import type { SupportedLocale } from "../i18n";

interface Props {
	locale?: SupportedLocale;
}
const { locale = "en" } = Astro.props;
---

<!-- CONTACT MODAL OVERLAY -->
<div class="fixed inset-0 bg-nocturno-base/50 hidden z-40" id="contactOverlay"></div>

<!-- CONTACT MODAL -->
<div class="fixed hidden w-[95%] md:w-[calc(100%-80px)] h-[90%] md:h-[calc(100%-80px)] top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-[#14110F] rounded-2xl z-50 overflow-hidden flex" id="contactFormContainer">
	<!-- Left: video panel (desktop only) -->
	<div class="hidden md:block relative w-[38%] shrink-0 overflow-hidden">
		<video src="/assets/saludo.mp4" autoplay muted loop playsinline preload="none" class="absolute inset-0 w-full h-full object-cover object-center"> </video>
		<!-- subtle vignette only on edges, keeps center clear -->
		<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_40%,rgba(20,17,15,0.45)_100%)] pointer-events-none"></div>
		<!-- logo -->
		<div class="absolute top-8 left-8 z-10">
			<Logo />
		</div>
	</div>

	<!-- Right: form panel -->
	<div class="flex flex-col flex-1 overflow-y-auto bg-[#14110F] border-l border-arena/[0.06]">
		<!-- top bar -->
		<div class="flex items-center justify-between px-8 md:px-12 pt-8 pb-0 shrink-0">
			<div class="md:hidden"><Logo /></div>
			<div class="md:ml-auto flex items-center justify-center bg-arena/8 border rounded-full border-arena/15 p-1.5 cursor-pointer form-toggle-button hover:bg-arena/15 transition-colors">
				<Icon class="text-arena h-5 w-5" name="x" />
			</div>
		</div>

		<!-- form content -->
		<div class="px-8 md:px-12 2xl:px-16 py-8 md:py-10">
			<!-- mobile heading -->
			<div class="md:hidden mb-8">
				<div class="w-6 h-px bg-[#EFA517] mb-4"></div>
				<h3 class="text-2xl font-medium text-arena tracking-[-0.02em]">Turn your vision into reality</h3>
				<p class="mt-2 text-sm text-arena/50">Tell us about your project.</p>
			</div>

			<Contactform locale={locale} />
		</div>
	</div>
</div>

<!-- TERMS MODAL OVERLAY -->
<div class="fixed inset-0 bg-nocturno-base/50 hidden z-40" id="termsOverlay"></div>

<!-- TERMS MODAL -->
<div id="termsModal" class="fixed hidden w-[95%] md:w-[calc(100%-80px)] h-[90%] md:h-[calc(100%-80px)] top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-nocturno-base rounded-xl z-50 overflow-hidden border border-arena/10">
	<iframe src="/Term/terms" class="w-full h-full rounded-xl" style="border: none;"></iframe>
</div>

<script>
	const contactFormContainer = document.getElementById("contactFormContainer");
	const contactOverlay = document.getElementById("contactOverlay");
	const termsModal = document.getElementById("termsModal");
	const termsOverlay = document.getElementById("termsOverlay");

	function toggleContactModal(show: boolean) {
		if (!contactFormContainer || !contactOverlay) return;
		if (show) {
			contactFormContainer.classList.remove("hidden");
			contactOverlay.classList.remove("hidden");
		} else {
			contactFormContainer.classList.add("hidden");
			contactOverlay.classList.add("hidden");
		}
	}

	function toggleTermsModal(show: boolean) {
		if (!termsModal || !termsOverlay) return;
		if (show) {
			termsModal.classList.remove("hidden");
			termsOverlay.classList.remove("hidden");
		} else {
			termsModal.classList.add("hidden");
			termsOverlay.classList.add("hidden");
		}
	}

	document.addEventListener("click", (event) => {
		const target = event.target;

		if (!(target instanceof Element)) return;

		// Toggle contact form modal
		if (target.closest(".form-toggle-button")) {
			if (contactFormContainer?.classList.contains("hidden")) {
				toggleContactModal(true);
			} else {
				toggleContactModal(false);
			}
			return;
		}

		// Open terms modal from any element with .open-terms
		if (target.closest(".open-terms")) {
			event.preventDefault();
			toggleTermsModal(true);
			return;
		}

		// Close contact modal clicking outside
		if (contactFormContainer && contactOverlay && !contactFormContainer.classList.contains("hidden")) {
			if (!contactFormContainer.contains(target) && !target.closest(".form-toggle-button")) {
				toggleContactModal(false);
			}
		}

		// Close terms modal clicking overlay
		if (termsModal && termsOverlay && !termsModal.classList.contains("hidden") && !termsModal.contains(target) && !target.closest(".open-terms")) {
			toggleTermsModal(false);
		}
	});

	// Listen for close message from terms iframe
	window.addEventListener("message", (event) => {
		const data = event.data;
		if (data && data.action === "close-terms") {
			toggleTermsModal(false);
		}
	});
</script>
