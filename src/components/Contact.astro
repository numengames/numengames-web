---
import { Icon } from "astro-icon/components";
import Contactform from "@components/contactform.astro";
import Logo from "./navbar/Logo.astro";
import type { SupportedLocale } from "../i18n";

interface Props {
	locale?: SupportedLocale;
}
const { locale = "en" } = Astro.props;
---

<!-- CONTACT MODAL OVERLAY -->
<div class="fixed inset-0 bg-black/50 hidden z-40" id="contactOverlay"></div>

<!-- CONTACT MODAL -->
<div
	class="fixed hidden w-[95%] md:w-[calc(100%-80px)] h-[90%] md:h-[calc(100%-80px)] top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-[#0a0b0f] rounded-2xl z-50 overflow-hidden flex"
	id="contactFormContainer">

	<!-- Left: video panel (desktop only) -->
	<div class="hidden md:block relative w-[38%] shrink-0 overflow-hidden">
		<video
			src="/assets/saludo.mp4"
			autoplay muted loop playsinline
			preload="none"
			class="absolute inset-0 w-full h-full object-cover object-center">
		</video>
		<!-- subtle vignette only on edges, keeps center clear -->
		<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_40%,rgba(0,0,0,0.45)_100%)] pointer-events-none"></div>
		<!-- logo -->
		<div class="absolute top-8 left-8 z-10">
			<Logo />
		</div>
	</div>

	<!-- Right: form panel -->
	<div class="flex flex-col flex-1 overflow-y-auto bg-[#0d0e12] border-l border-white/[0.06]">

		<!-- top bar -->
		<div class="flex items-center justify-between px-8 md:px-12 pt-8 pb-0 shrink-0">
			<div class="md:hidden"><Logo /></div>
			<div class="md:ml-auto flex items-center justify-center bg-white/8 border rounded-full border-white/15 p-1.5 cursor-pointer form-toggle-button hover:bg-white/15 transition-colors">
				<Icon class="text-white h-5 w-5" name="x" />
			</div>
		</div>

		<!-- form content -->
		<div class="px-8 md:px-12 2xl:px-16 py-8 md:py-10">

			<!-- brand mark -->
			<div class="hidden md:flex justify-start mb-8">
				<img
					src="/assets/Logo_Khepri_Web.png"
					alt="Numen Games"
					class="w-20 h-auto"
					style="filter: invert(1) brightness(2) sepia(0.4) saturate(2) hue-rotate(350deg); mix-blend-mode: screen; opacity: 0.9;"
				/>
			</div>

			<!-- mobile heading -->
			<div class="md:hidden mb-8">
				<div class="w-6 h-px bg-[#D9B86A] mb-4"></div>
				<h3 class="text-2xl font-medium text-primary-beige tracking-[-0.02em]">Turn your vision into reality</h3>
				<p class="mt-2 text-sm text-primary-beige/50">Tell us about your project.</p>
			</div>

			<Contactform locale={locale} />
		</div>
	</div>

</div>

<!-- TERMS MODAL OVERLAY -->
<div class="fixed inset-0 bg-black/50 hidden z-40" id="termsOverlay"></div>

<!-- TERMS MODAL -->
<div
	id="termsModal"
	class="fixed hidden w-[95%] md:w-[calc(100%-80px)] h-[90%] md:h-[calc(100%-80px)] top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-primary-panther rounded-xl z-50 overflow-hidden border border-white/10">
	<iframe
		src="/Term/terms"
		class="w-full h-full rounded-xl"
		style="border: none;"
	></iframe>
</div>

<!-- PRIVACY MODAL OVERLAY -->
<div class="fixed inset-0 bg-black/50 hidden z-40" id="privacyOverlay"></div>

<!-- PRIVACY MODAL -->
<div
	id="privacyModal"
	class="fixed hidden w-[95%] md:w-[calc(100%-80px)] h-[90%] md:h-[calc(100%-80px)] top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-primary-panther rounded-xl z-50 overflow-hidden border border-white/10">
	<iframe
		src="/Term/privacy"
		class="w-full h-full rounded-xl"
		style="border: none;"
	></iframe>
</div>

<!-- COOKIES MODAL OVERLAY -->
<div class="fixed inset-0 bg-black/50 hidden z-40" id="cookiesOverlay"></div>

<!-- COOKIES MODAL -->
<div
	id="cookiesModal"
	class="fixed hidden w-[95%] md:w-[calc(100%-80px)] h-[90%] md:h-[calc(100%-80px)] top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-primary-panther rounded-xl z-50 overflow-hidden border border-white/10">
	<iframe
		src="/Term/cookies"
		class="w-full h-full rounded-xl"
		style="border: none;"
	></iframe>
</div>

<script>
	const contactFormContainer = document.getElementById("contactFormContainer");
	const contactOverlay = document.getElementById("contactOverlay");
	const termsModal = document.getElementById("termsModal");
	const termsOverlay = document.getElementById("termsOverlay");
	const privacyModal = document.getElementById("privacyModal");
	const privacyOverlay = document.getElementById("privacyOverlay");
	const cookiesModal = document.getElementById("cookiesModal");
	const cookiesOverlay = document.getElementById("cookiesOverlay");

	function toggleContactModal(show: boolean) {
		if (!contactFormContainer || !contactOverlay) return;
		if (show) {
			contactFormContainer.classList.remove("hidden");
			contactOverlay.classList.remove("hidden");
		} else {
			contactFormContainer.classList.add("hidden");
			contactOverlay.classList.add("hidden");
		}
	}

	function toggleTermsModal(show: boolean) {
		if (!termsModal || !termsOverlay) return;
		if (show) {
			termsModal.classList.remove("hidden");
			termsOverlay.classList.remove("hidden");
		} else {
			termsModal.classList.add("hidden");
			termsOverlay.classList.add("hidden");
		}
	}

	function togglePrivacyModal(show: boolean) {
		if (!privacyModal || !privacyOverlay) return;
		if (show) {
			privacyModal.classList.remove("hidden");
			privacyOverlay.classList.remove("hidden");
		} else {
			privacyModal.classList.add("hidden");
			privacyOverlay.classList.add("hidden");
		}
	}

	function toggleCookiesModal(show: boolean) {
		if (!cookiesModal || !cookiesOverlay) return;
		const ccMain = document.getElementById("cc-main");
		if (show) {
			cookiesModal.classList.remove("hidden");
			cookiesOverlay.classList.remove("hidden");
			if (ccMain) ccMain.style.display = "none";
		} else {
			cookiesModal.classList.add("hidden");
			cookiesOverlay.classList.add("hidden");
			if (ccMain) ccMain.style.display = "";
		}
	}

	document.addEventListener("click", (event) => {
		const target = event.target;

		if (!(target instanceof Element)) return;

		// Toggle contact form modal
		if (target.closest(".form-toggle-button")) {
			if (contactFormContainer?.classList.contains("hidden")) {
				toggleContactModal(true);
			} else {
				toggleContactModal(false);
			}
			return;
		}

		// Open terms modal from any element with .open-terms
		if (target.closest(".open-terms")) {
			event.preventDefault();
			toggleTermsModal(true);
			return;
		}

		// Open privacy modal from any element with .open-privacy
		if (target.closest(".open-privacy")) {
			event.preventDefault();
			togglePrivacyModal(true);
			return;
		}

		// Open cookies modal from any element with .open-cookies
		if (target.closest(".open-cookies")) {
			event.preventDefault();
			toggleCookiesModal(true);
			return;
		}

		// Close contact modal clicking outside
		if (
			contactFormContainer &&
			contactOverlay &&
			!contactFormContainer.classList.contains("hidden")
		) {
			if (!contactFormContainer.contains(target) && !target.closest(".form-toggle-button")) {
				toggleContactModal(false);
			}
		}

		// Close terms modal clicking overlay
		if (
			termsModal &&
			termsOverlay &&
			!termsModal.classList.contains("hidden") &&
			!termsModal.contains(target) &&
			!target.closest(".open-terms")
		) {
			toggleTermsModal(false);
		}

		// Close privacy modal clicking overlay
		if (
			privacyModal &&
			privacyOverlay &&
			!privacyModal.classList.contains("hidden") &&
			!privacyModal.contains(target) &&
			!target.closest(".open-privacy")
		) {
			togglePrivacyModal(false);
		}

		// Close cookies modal clicking overlay
		if (
			cookiesModal &&
			cookiesOverlay &&
			!cookiesModal.classList.contains("hidden") &&
			!cookiesModal.contains(target) &&
			!target.closest(".open-cookies")
		) {
			toggleCookiesModal(false);
		}
	});

	// Listen for close messages from iframes
	window.addEventListener("message", (event) => {
		const data = event.data;
		if (data && data.action === "close-terms") toggleTermsModal(false);
		if (data && data.action === "close-privacy") togglePrivacyModal(false);
		if (data && data.action === "close-cookies") toggleCookiesModal(false);
	});
</script>
