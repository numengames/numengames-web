---
import Logo from "./Logo.astro";
import StickyHeader from "./StickyHeader.astro";
import MenuListItem from "./MenuListItem.astro";
import ActionButtons from "./ActionButtons.astro";
import DropdownInfoItem from "./DropdownInfoItem.astro";
import DropdownServiceItem from "./DropdownServiceItem.astro";
import DropdownFeaturedItem from "./DropdownFeaturedItem.astro";
import { getLocaleFromURL, DEFAULT_LOCALE, type SupportedLocale } from "../../i18n";

// Get current locale from URL or use default
const currentLocale = getLocaleFromURL(Astro.url.pathname) || DEFAULT_LOCALE;

// Helper function to get localized path
const getLocalizedPath = (path: string) => `/${currentLocale}${path.startsWith('/') ? path : `/${path}`}`;
---

<div class="fixed z-50 w-full mx-auto mt-4 lg:mt-10 px-4 lg:px-10 left-0 right-0">
	<StickyHeader
		scrollY={50}
		class="sticky top-0 w-full py-2 lg:py-3 bg-primary-panther/20 lg:shadow-[0px_0px_20px_0px_rgba(255,255,255,0.15)_inset] backdrop-blur-[25px] rounded-lg border border-white/10"
		activeClass="custom-hidden"
		defaultClass="custom-visible">
		<div class="relative w-full overflow-visible">
			<div class="flex items-center justify-between lg:px-6">
				<Logo />
				<div class="text-base font-normal leading-6 text-center lg:flex">
					<ul
						class="hidden lg:flex flex-col gap-3 text-center lg:flex-row lg:items-center lg:gap-5">
						<MenuListItem label="Services" customClass="service-toggle" />
						<MenuListItem label="Company" customClass="company-toggle" />
						<MenuListItem link={getLocalizedPath("/help-center")} label="Help Center" />
						<MenuListItem link={getLocalizedPath("/pricing")} label="Pricing" />
						<MenuListItem link={getLocalizedPath("/numinia")} label="Numen" />
					</ul>
				</div>
				<div class="flex items-center gap-4">
					<ActionButtons />
					<button
						id="mobile-menu-button"
						class="lg:hidden p-2 rounded-lg hover:bg-white/10 transition-colors"
						aria-label="Toggle mobile menu">
						<svg
							class="w-6 h-6 text-white"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24">
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M4 6h16M4 12h16M4 18h16" />
						</svg>
					</button>
				</div>
			</div>
			<div
				id="mobile-menu"
				class="hidden lg:hidden absolute top-full left-0 w-full mt-4 px-4 py-4 bg-primary-panther/95 backdrop-blur-[25px] border-t border-b border-white/10 shadow-lg">
				<ul class="flex flex-col gap-4 w-full">
					<li>
						<button class="w-full text-left py-2 hover:text-primary-coralRed transition-colors service-toggle">
							Services
						</button>
					</li>
					<li>
						<button class="w-full text-left py-2 hover:text-primary-coralRed transition-colors company-toggle">
							Company
						</button>
					</li>
					<li>
						<a
							href={getLocalizedPath("/help-center")}
							class="block w-full text-left py-2 hover:text-primary-coralRed transition-colors">
							Help Center
						</a>
					</li>
					<li>
						<a
							href={getLocalizedPath("/pricing")}
							class="block w-full text-left py-2 hover:text-primary-coralRed transition-colors">
							Pricing
						</a>
					</li>
					<li>
						<a
							href={getLocalizedPath("/")}
							class="block w-full text-left py-2 hover:text-primary-coralRed transition-colors">
							Numen
						</a>
					</li>
					<li class="mt-4">
						<a href="https://city-of-mesa.numinia.xyz" target="_blank" class="block w-full">
							<button
								class="w-full px-5 py-2 bg-basics-white/10 border-basics-white/20 rounded border-tl border hover:bg-basics-white/30">
								Try a demo
							</button>
						</a>
					</li>
					<li>
						<button
							class="w-full px-5 py-2 bg-primary-coralRed rounded hover:bg-primary-darkRed form-toggle-button">
							Talk to us
						</button>
					</li>
				</ul>
			</div>
		</div>
		<div
			class="hidden items-stretch justify-between gap-4 xl:gap-6 mt-6 px-4 xl:px-10 toggle-div bg-primary-panther/95 backdrop-blur-[25px] border-t border-b border-white/10 z-50 max-h-[80vh] overflow-y-auto overflow-x-hidden fixed inset-x-0">
			<button 
				class="absolute top-4 right-4 lg:top-6 lg:right-6 w-10 h-10 flex items-center justify-center rounded-full bg-basics-white/10 hover:bg-basics-white/20 border border-white/10 transition-all duration-200 z-50 group"
				onclick="document.querySelector('.toggle-div').style.display = 'none'">
				<svg
					class="w-5 h-5 text-white transform group-hover:rotate-90 transition-transform duration-200"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24">
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
			<div class="w-full lg:pt-8 pb-8">
				<div class="flex flex-col lg:flex-row w-full gap-4 lg:gap-6 services-container">
					<DropdownServiceItem
						title="ENGAGE"
						subtitle="Engagement service"
						description="We develop immersive 3D environments that transform how your organization retains talent."
						link={getLocalizedPath("/services/engage")}
						customClass="services-item flex-1"
						icon="strategy"
						cardImg="/assets/Burruno.png"
					/>
					<DropdownServiceItem
						title="TRAINING"
						subtitle="Immersive 3D environments"
						description="Create immersive 3D environments that strengthen your organization's talent retention, values, and culture."
						link={getLocalizedPath("/services/training")}
						customClass="services-item flex-1"
						icon="sword"
						cardImg="/assets/spring-1.png"
					/>
					<DropdownServiceItem
						title="EXPERIENCE"
						subtitle="Tailored Gamified Experiences"
						description="We design fully customized gamified experiences to meet specific business objectives."
						link={getLocalizedPath("/services/experience")}
						customClass="services-item flex-1"
						icon="game-controller"
						cardImg="/assets/Cone.png"
					/>
				</div>
				<div class="w-full mt-4 lg:mt-6">
					<DropdownInfoItem customClass="company-item" />
				</div>
			</div>
		</div>
	</StickyHeader>
</div>

<script>
	let lastClickedElement: Element | null = null;

	const toggleElements = document.querySelectorAll(
		".service-toggle, .company-toggle"
	);
	const toggleDiv = document.querySelector(".toggle-div");
	const mobileMenuButton = document.getElementById("mobile-menu-button");
	const mobileMenu = document.getElementById("mobile-menu");
	const servicesContainer = document.querySelector(".services-container");
	const companyContainer = document.querySelector(".company-container");

	// Función para cerrar todos los menús
	const closeAllMenus = () => {
		if (toggleDiv instanceof HTMLElement) {
			const serviceItems = toggleDiv.querySelectorAll<HTMLElement>(".services-item");
			const companyItems = toggleDiv.querySelectorAll<HTMLElement>(".company-item");
			
			serviceItems.forEach(item => item.style.display = "none");
			companyItems.forEach(item => item.style.display = "none");
			toggleDiv.style.display = "none";
		}
		if (mobileMenu) {
			mobileMenu.classList.add("hidden");
			const svg = mobileMenuButton?.querySelector("svg");
			if (svg) {
				svg.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />`;
			}
		}
		lastClickedElement = null;
	};

	if (mobileMenuButton && mobileMenu) {
		mobileMenuButton.addEventListener("click", (e) => {
			e.preventDefault();
			e.stopPropagation();
			
			// Cerrar el menú de servicios si está abierto
			if (toggleDiv instanceof HTMLElement) {
				toggleDiv.style.display = "none";
				lastClickedElement = null;
			}
			
			mobileMenu.classList.toggle("hidden");
			const svg = mobileMenuButton.querySelector("svg");
			if (svg) {
				if (mobileMenu.classList.contains("hidden")) {
					svg.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />`;
				} else {
					svg.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />`;
				}
			}
		});

		// Cerrar el menú móvil al hacer clic fuera
		document.addEventListener("click", (event) => {
			if (!mobileMenuButton.contains(event.target as Node) && !mobileMenu.contains(event.target as Node)) {
				closeAllMenus();
			}
		});
	}

	if (toggleDiv instanceof HTMLElement) {
		const serviceItems = toggleDiv.querySelectorAll<HTMLElement>(".services-item");
		const companyItems = toggleDiv.querySelectorAll<HTMLElement>(".company-item");

		const toggleDisplay = (
			items: NodeListOf<HTMLElement>,
			displayStyle: string
		) => {
			items.forEach((item) => {
				item.style.display = displayStyle;
			});
		};

		toggleElements.forEach((element) => {
			element.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				
				const isServiceToggle = element.classList.contains("service-toggle");

				if (lastClickedElement === element) {
					closeAllMenus();
				} else {
					// Cerrar el menú móvil si está abierto
					if (mobileMenu) {
						mobileMenu.classList.add("hidden");
						const svg = mobileMenuButton?.querySelector("svg");
						if (svg) {
							svg.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />`;
						}
					}

					if (servicesContainer instanceof HTMLElement && companyContainer instanceof HTMLElement) {
						if (isServiceToggle) {
							servicesContainer.style.display = "flex";
							companyContainer.style.display = "none";
						} else {
							servicesContainer.style.display = "none";
							companyContainer.style.display = "block";
						}
					}

					toggleDisplay(serviceItems, isServiceToggle ? "flex" : "none");
					toggleDisplay(companyItems, isServiceToggle ? "none" : "flex");
					toggleDiv.style.display = "flex";
					lastClickedElement = element;
				}
			});
		});

		// Cerrar el dropdown al hacer clic fuera
		document.addEventListener("click", (event) => {
			if (!toggleDiv.contains(event.target as Node) && 
				!Array.from(toggleElements).some(el => el.contains(event.target as Node))) {
				closeAllMenus();
			}
		});

		window.addEventListener("scroll", () => {
			if (window.scrollY > 50) {
				closeAllMenus();
			}
		});
	}
</script>
