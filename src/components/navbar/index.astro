---
import Logo from "./Logo.astro";
import StickyHeader from "./StickyHeader.astro";
import MenuListItem from "./MenuListItem.astro";
import ActionButtons from "./ActionButtons.astro";
import DropdownInfoItem from "./DropdownInfoItem.astro";
import DropdownServiceItem from "./DropdownServiceItem.astro";
import { getLocaleFromURL, DEFAULT_LOCALE } from "../../i18n";
import { getNavbarTranslations } from "../../i18n/translations/navbar";

const currentLocale = getLocaleFromURL(Astro.url.pathname) || DEFAULT_LOCALE;
const getLocalizedPath = (path: string) => `/${currentLocale}${path.startsWith('/') ? path : `/${path}`}`;
const navT = getNavbarTranslations(currentLocale);
---

<div class="fixed top-0 z-50 w-full mx-auto mt-4 lg:mt-10 px-4 lg:px-10 left-0 right-0">
	<StickyHeader
		scrollY={200}
		class="sticky top-0 w-full py-2 lg:py-3 bg-[rgba(20,20,20,0.42)] lg:shadow-[0px_0px_24px_0px_rgba(217,184,106,0.12)_inset] backdrop-blur-[25px] rounded-lg border border-[rgba(217,184,106,0.14)]"
		activeClass="custom-hidden"
		defaultClass="custom-visible">
		<div class="relative w-full overflow-visible">
			<div class="flex items-center justify-between lg:px-6">
				<Logo />
				<div class="text-base font-normal leading-6 text-center lg:flex">
					<ul class="hidden lg:flex flex-col gap-3 text-center lg:flex-row lg:items-center lg:gap-5">
						<MenuListItem label={navT.services} customClass="service-toggle" />
						<MenuListItem label={navT.company} customClass="company-toggle" />
						<MenuListItem link={getLocalizedPath("/portfolio")} label={navT.portfolio} />
						<MenuListItem link={getLocalizedPath("/pricing")} label={navT.pricing} />
						<MenuListItem link={getLocalizedPath("/help-center")} label={navT.helpCenter} />
						<MenuListItem link={getLocalizedPath("/numinia")} label={navT.numinia} />
					</ul>
				</div>
				<div class="flex items-center gap-4">
					<ActionButtons />
					<!-- Hamburger button with animated lines -->
					<button
						id="mobile-menu-button"
						class="lg:hidden p-2.5 rounded-lg hover:bg-[rgba(217,184,106,0.08)] transition-colors border border-[rgba(217,184,106,0.12)]"
						aria-label="Toggle mobile menu">
						<div class="hamburger w-5 h-4 flex flex-col justify-between">
							<span class="hamburger-top block h-px bg-white rounded-full transition-all duration-300 origin-center"></span>
							<span class="hamburger-mid block h-px bg-white rounded-full transition-all duration-300 origin-center"></span>
							<span class="hamburger-bot block h-px bg-white rounded-full transition-all duration-300 origin-center"></span>
						</div>
					</button>
				</div>
			</div>

			<!-- Mobile menu dropdown -->
			<div
				id="mobile-menu"
				class="hidden lg:hidden absolute top-full left-0 w-full mt-2 bg-[rgba(18,18,18,0.97)] backdrop-blur-[30px] border border-[rgba(217,184,106,0.14)] rounded-lg shadow-[0_8px_32px_rgba(0,0,0,0.4)] overflow-hidden">

				<ul class="flex flex-col w-full py-2">
					<li>
						<button class="service-toggle nav-item text-sm font-medium">
							<span>{navT.services}</span>
							<svg class="w-3.5 h-3.5 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
							</svg>
						</button>
					</li>
					<li>
						<button class="company-toggle nav-item text-sm font-medium">
							<span>{navT.company}</span>
							<svg class="w-3.5 h-3.5 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
							</svg>
						</button>
					</li>

					<li class="mx-5 my-1"><div class="h-px bg-[rgba(217,184,106,0.08)]"></div></li>

					<li>
						<a href={getLocalizedPath("/portfolio")} class="nav-item text-sm font-medium">
							<span>{navT.portfolio}</span>
							<svg class="w-3.5 h-3.5 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
							</svg>
						</a>
					</li>
					<li>
						<a href={getLocalizedPath("/pricing")} class="nav-item text-sm font-medium">
							<span>{navT.pricing}</span>
							<svg class="w-3.5 h-3.5 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
							</svg>
						</a>
					</li>
					<li>
						<a href={getLocalizedPath("/help-center")} class="nav-item text-sm font-medium">
							<span>{navT.helpCenter}</span>
							<svg class="w-3.5 h-3.5 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
							</svg>
						</a>
					</li>
					<li>
						<a href={getLocalizedPath("/numinia")} class="nav-item text-sm font-medium">
							<span>{navT.numinia}</span>
							<svg class="w-3.5 h-3.5 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
							</svg>
						</a>
					</li>
				</ul>

				<div class="px-4 py-4 border-t border-[rgba(217,184,106,0.1)]">
					<button class="form-toggle-button contact-btn">
						{navT.contact}
					</button>
				</div>
			</div>
		</div>

		<div
			class="hidden items-stretch justify-between gap-4 xl:gap-6 mt-6 px-4 xl:px-10 toggle-div bg-[rgba(23,23,23,0.96)] backdrop-blur-[25px] border-t border-b border-[rgba(217,184,106,0.14)] z-50 max-h-[80vh] overflow-y-auto overflow-x-hidden fixed inset-x-0">
			<button
				class="absolute top-4 right-4 lg:top-6 lg:right-6 w-10 h-10 flex items-center justify-center rounded-full bg-white/8 hover:bg-[rgba(217,184,106,0.08)] border border-[rgba(217,184,106,0.14)] transition-all duration-200 z-50 group"
				onclick="document.querySelector('.toggle-div').style.display = 'none'">
				<svg
					class="w-5 h-5 text-white transform group-hover:rotate-90 transition-transform duration-200"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
			<div class="w-full lg:pt-8 pb-8">
				<div class="flex flex-col lg:flex-row w-full gap-4 lg:gap-6 services-container">
					<DropdownServiceItem
						title="ENGAGE"
						subtitle={navT.engage.subtitle}
						description={navT.engage.desc}
						link={getLocalizedPath("/services/engage")}
						customClass="services-item flex-1"
						icon="strategy"
						cardImg="/assets/Burruno.png"
					/>
					<DropdownServiceItem
						title="TRAINING"
						subtitle={navT.training.subtitle}
						description={navT.training.desc}
						link={getLocalizedPath("/services/training")}
						customClass="services-item flex-1"
						icon="sword"
						cardImg="/assets/spring-1.png"
					/>
					<DropdownServiceItem
						title="EXPERIENCE"
						subtitle={navT.experience.subtitle}
						description={navT.experience.desc}
						link={getLocalizedPath("/services/experience")}
						customClass="services-item flex-1"
						icon="game-controller"
						cardImg="/assets/Cone.png"
					/>
				</div>
				<div class="w-full mt-4 lg:mt-6">
					<DropdownInfoItem customClass="company-item" />
				</div>
			</div>
		</div>
	</StickyHeader>
</div>

<style is:global>
	/* Arrow rotation on active toggle */
	.service-toggle svg, .company-toggle svg {
		transition: transform 0.25s ease;
	}
	.service-toggle.is-active svg, .company-toggle.is-active svg {
		transform: rotate(180deg);
	}

	/* Hamburger open state */
	.hamburger.is-open .hamburger-top {
		transform: translateY(8px) rotate(45deg);
	}
	.hamburger.is-open .hamburger-mid {
		opacity: 0;
		transform: scaleX(0);
	}
	.hamburger.is-open .hamburger-bot {
		transform: translateY(-8px) rotate(-45deg);
	}

	/* Mobile menu nav items */
	#mobile-menu .nav-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 20px;
		border-left: 2px solid transparent;
		transition: background 0.15s, border-color 0.15s, color 0.15s;
		cursor: pointer;
		width: 100%;
		color: #F5ECD6;
	}
	#mobile-menu .nav-item:hover,
	#mobile-menu .nav-item.is-tapped {
		background: rgba(217, 184, 106, 0.08);
		border-left-color: #D9B86A;
		color: #D9B86A;
	}

	/* Contact button */
	#mobile-menu .contact-btn {
		width: 100%;
		padding: 12px 20px;
		border-radius: 8px;
		font-weight: 500;
		font-size: 14px;
		background: rgba(217, 184, 106, 0.1);
		color: #D9B86A;
		border: 1px solid rgba(217, 184, 106, 0.4);
		transition: background 0.2s, color 0.2s, box-shadow 0.2s;
		cursor: pointer;
	}
	#mobile-menu .contact-btn:hover,
	#mobile-menu .contact-btn.is-tapped {
		background: #D9B86A;
		color: #171717;
		box-shadow: 0 0 24px rgba(217, 184, 106, 0.3);
	}
</style>

<script>
	let lastClickedElement: Element | null = null;

	const toggleElements = document.querySelectorAll(".service-toggle, .company-toggle");
	const toggleDiv = document.querySelector(".toggle-div");
	const mobileMenuButton = document.getElementById("mobile-menu-button");
	const mobileMenu = document.getElementById("mobile-menu");
	const hamburger = mobileMenuButton?.querySelector(".hamburger");
	const servicesContainer = document.querySelector(".services-container");
	const companyContainer = document.querySelector(".company-container");

	const closeAllMenus = () => {
		if (toggleDiv instanceof HTMLElement) {
			const serviceItems = toggleDiv.querySelectorAll<HTMLElement>(".services-item");
			const companyItems = toggleDiv.querySelectorAll<HTMLElement>(".company-item");
			serviceItems.forEach(item => item.style.display = "none");
			companyItems.forEach(item => item.style.display = "none");
			toggleDiv.style.display = "none";
		}
		if (mobileMenu) {
			mobileMenu.classList.add("hidden");
			hamburger?.classList.remove("is-open");
		}
		toggleElements.forEach(el => el.classList.remove("is-active"));
		lastClickedElement = null;
	};

	if (mobileMenuButton && mobileMenu) {
		mobileMenuButton.addEventListener("click", (e) => {
			e.preventDefault();
			e.stopPropagation();

			if (toggleDiv instanceof HTMLElement) {
				toggleDiv.style.display = "none";
				lastClickedElement = null;
			}

			const isHidden = mobileMenu.classList.toggle("hidden");
			hamburger?.classList.toggle("is-open", !isHidden);
		});

		document.addEventListener("click", (event) => {
			if (!mobileMenuButton.contains(event.target as Node) && !mobileMenu.contains(event.target as Node)) {
				closeAllMenus();
			}
		});
	}

	if (toggleDiv instanceof HTMLElement) {
		const serviceItems = toggleDiv.querySelectorAll<HTMLElement>(".services-item");
		const companyItems = toggleDiv.querySelectorAll<HTMLElement>(".company-item");

		const toggleDisplay = (items: NodeListOf<HTMLElement>, displayStyle: string) => {
			items.forEach(item => { item.style.display = displayStyle; });
		};

		toggleElements.forEach((element) => {
			element.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();

				const isServiceToggle = element.classList.contains("service-toggle");

				if (lastClickedElement === element) {
					closeAllMenus();
				} else {
					if (mobileMenu) {
						mobileMenu.classList.add("hidden");
						hamburger?.classList.remove("is-open");
					}

					if (servicesContainer instanceof HTMLElement && companyContainer instanceof HTMLElement) {
						servicesContainer.style.display = isServiceToggle ? "flex" : "none";
						companyContainer.style.display = isServiceToggle ? "none" : "block";
					}

					toggleDisplay(serviceItems, isServiceToggle ? "flex" : "none");
					toggleDisplay(companyItems, isServiceToggle ? "none" : "flex");
					toggleDiv.style.display = "flex";
					toggleElements.forEach(el => el.classList.remove("is-active"));
					element.classList.add("is-active");
					lastClickedElement = element;
				}
			});
		});

		document.addEventListener("click", (event) => {
			if (!toggleDiv.contains(event.target as Node) &&
				!Array.from(toggleElements).some(el => el.contains(event.target as Node))) {
				closeAllMenus();
			}
		});

		window.addEventListener("scroll", () => {
			if (window.scrollY > 50) closeAllMenus();
		});
	}

	// Touch feedback for mobile nav items
	document.querySelectorAll("#mobile-menu .nav-item, #mobile-menu .contact-btn").forEach(el => {
		el.addEventListener("touchstart", () => el.classList.add("is-tapped"), { passive: true });
		el.addEventListener("touchend", () => setTimeout(() => el.classList.remove("is-tapped"), 250), { passive: true });
		el.addEventListener("touchcancel", () => el.classList.remove("is-tapped"), { passive: true });
	});
</script>
