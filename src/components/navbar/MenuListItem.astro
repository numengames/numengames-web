---
import { Icon } from "astro-icon/components";

const { label, link, customClass = "" } = Astro.props;
---

<li class="text-primary-beige/70 hover:text-[#EFA517] hover:bg-[rgba(239,165,23,0.08)] py-1 px-3 rounded-md text-base 3xl:text-xl font-light transition-colors">
	{
		link ? (
			<a href={link}>
				<span>{label}</span>
			</a>
		) : (
			<button class={`flex items-center toggle-experience ${customClass}`}>
				<span>{label}</span>
				<span class="ml-2">
					<Icon class="w-3 h-3 lg:w-4 lg:h-4" name="arrow-down" />
				</span>
			</button>
		)
	}
</li>
