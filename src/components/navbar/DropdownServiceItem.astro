---
import { Icon } from "astro-icon/components";

import { getLocaleFromURL, DEFAULT_LOCALE } from "../../i18n";

const { link, icon, title, subtitle, description, customClass = "" } = Astro.props;

const currentLocale = getLocaleFromURL(Astro.url.pathname) || DEFAULT_LOCALE;
const readMore = currentLocale === "es" ? "Saber más" : "Read More";
---

<div class={`relative w-full ${customClass}`}>
	<a title={title} href={link}>
		<div class="flex flex-col justify-between items-start gap-3 h-full p-6 bg-arena/5 hover:bg-arena/10 border border-ambar/30 rounded-lg transition-all duration-200">
			<div class="flex flex-col w-full">
				<div class="flex items-center justify-center w-9 h-9 bg-ambar/20 rounded-full">
					<Icon name={icon} class="w-full h-full p-2 text-ambar" />
				</div>

				<p class="text-sm font-light text-ambar uppercase font-geistMono mt-3">
					{title}
				</p>

				<p class="text-xl font-medium text-arena mt-2">
					{subtitle}
				</p>

				<p class="mt-3 text-sm text-arena/65 line-clamp-3">
					{description}
				</p>
			</div>

			<div class="mt-6 py-2 px-4 text-ambar border border-ambar/40 rounded hover:bg-ambar/10 transition-colors duration-200 text-sm">
				{readMore}
			</div>
		</div>
	</a>
</div>
