---
import { Icon } from "astro-icon/components";
---

<div class="flex flex-row lg:items-center lg:gap-4">
	<div class="text-base font-light gap-3 text-white hidden lg:flex">
		<a href="https://city-of-mesa.numinia.xyz" target="_blank">
			<button
				class="3xl:text-xl px-5 py-2 mt-4 bg-basics-white/10 border-basics-white/20 rounded border-tl border hover:bg-basics-white/30 lg:mt-0">
				Try a demo
			</button>
		</a>

		<button
			class="3xl:text-xl px-5 py-2 mt-4 bg-primary-coralRed text-basics-black font-normal rounded hover:bg-primary-darkRed lg:mt-0 form-toggle-button">
			Talk to us
		</button>
	</div>
</div>
