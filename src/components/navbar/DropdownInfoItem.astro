---
import { Icon } from "astro-icon/components";
import { getLocaleFromURL, DEFAULT_LOCALE } from "../../i18n";
import { getNavbarTranslations } from "../../i18n/translations/navbar";

const { customClass = "" } = Astro.props;

const currentLocale = getLocaleFromURL(Astro.url.pathname) || DEFAULT_LOCALE;
const getLocalizedPath = (path: string) => `/${currentLocale}${path.startsWith('/') ? path : `/${path}`}`;
const navT = getNavbarTranslations(currentLocale);

const items = [
	{ key: "team",      icon: "ghost",  link: getLocalizedPath("/team"),      ...navT.team },
	{ key: "manifesto", icon: "scroll", link: getLocalizedPath("/manifesto"), ...navT.manifesto },
	{ key: "blog",      icon: "book",   link: "/blog",                        ...navT.blog },
];
---

<div class={`w-full ${customClass} hidden`}>
	<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 lg:gap-6">
		{items.map((item) => (
			<a title={item.title} href={item.link} class="relative w-full">
				<div class="flex flex-col justify-between items-start gap-3 h-full p-6 bg-basics-white/5 hover:bg-basics-white/10 border border-primary-coralRed/30 rounded-lg transition-all duration-200">
					<div class="flex flex-col w-full">
						<div class="flex items-center justify-center w-9 h-9 bg-primary-coralRed/20 rounded-full">
							<Icon name={item.icon} class="w-full h-full p-2 text-primary-coralRed" />
						</div>
						<p class="text-xl font-medium text-white mt-4">
							{item.title}
						</p>
						<p class="mt-3 text-sm text-white/65 line-clamp-3">
							{item.desc}
						</p>
					</div>
					<div class="mt-4 py-2 px-4 text-primary-coralRed border border-primary-coralRed/40 rounded hover:bg-primary-coralRed/10 transition-colors duration-200 text-sm">
						{navT.readMore}
					</div>
				</div>
			</a>
		))}
	</div>
</div>
