---
import PricingCards from "./PricingCards.svelte";
import { getLocaleStaticPaths, type SupportedLocale } from "../../../i18n";
import Layout from "@layouts/Layout.astro";
import HeroDesktopSection from "./HeroDesktop.astro";

export const getStaticPaths = getLocaleStaticPaths;

const { locale } = Astro.params;
const currentLocale = (locale as SupportedLocale) || 'en';

const markdownFile = await Astro.glob("@pages/content/pricing.md");
const { frontmatter } = markdownFile[0];
---

<Layout title={frontmatter.title} locale={currentLocale}>
	<main>

		<!-- HERO -->
		<HeroDesktopSection textObj={frontmatter.heroSection} class="xl:flex" />

		<!-- NUEVA SECCIÓN DE CARDS -->
		<section class="mt-20 px-4">
			<PricingCards client:only="svelte" />
		</section>

	</main>
</Layout>

