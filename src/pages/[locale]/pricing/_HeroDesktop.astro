---
import { getLocaleStaticPaths } from "../../../i18n";
import Container from "@components/Container.svelte";

import HeroDesktopServices from "./_HeroDesktop.svelte";

interface Props { textObj: any; class?: string }
const { textObj } = Astro.props;

export const getStaticPaths = getLocaleStaticPaths;
---

<Container
	className="flex flex-col items-center justify-center pt-16 xl:pt-20 pb-10"
	bgColor="bg-[#171717]">
	<HeroDesktopServices {textObj} client:only="svelte" />
</Container>
