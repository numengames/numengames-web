---
import SiteLayout from "@layouts/SiteLayout.astro";
import { getDictionary } from "@content/dictionary";
import type { SupportedLocale } from "@lib/locale";
import "@styles/inner-pages.css";

export const prerender = true;
export async function getStaticPaths() {
	return [{ params: { locale: "es" } }, { params: { locale: "en" } }];
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = getDictionary(locale);
const c = t.contact;
const contactEmail = t.footer.contactEmail;
---

<SiteLayout title={`Numen Games — ${c.title}`} description={c.lead} locale={locale} path="/contacto">
	<section class="page-hero">
		<div class="container">
			<h1>{c.title}</h1>
			<p class="page-hero__lead measure">{c.lead}</p>
		</div>
	</section>

	<section class="section page-section">
		<div class="container contact-container">
			<!--
				Sin servicio de terceros. Web3Forms se retiró el 2026-09-16 (legacy):
				dependía de una clave que nunca existió en CI y bloqueó cinco
				despliegues. El formulario compone un correo en el cliente de
				correo del visitante, con los campos ya escritos; el destino es
				hola@numen.games, el mismo del pie. Cero infraestructura, cero
				secretos, imposible que un envío se pierda en silencio.
			-->
			<form id="contact-form" class="contact-form" data-contact-email={contactEmail} novalidate>

				<div class="field">
					<label for="name">{c.fields.name}</label>
					<input id="name" name="name" type="text" required autocomplete="name" />
				</div>

				<div class="field">
					<label for="email">{c.fields.email}</label>
					<input id="email" name="email" type="email" required autocomplete="email" />
				</div>

				<div class="field">
					<label for="org">{c.fields.org}</label>
					<input id="org" name="organization" type="text" required autocomplete="organization" />
				</div>

				<div class="field">
					<label for="goal">{c.fields.goal}</label>
					<textarea id="goal" name="goal" required rows="4"></textarea>
				</div>

				<fieldset class="field-group">
					<legend class="visually-hidden">
						{locale === "en" ? "Optional details" : "Datos opcionales"}
					</legend>
					<div class="field">
						<label for="date">{c.fields.dateOptional}</label>
						<input id="date" name="event_date" type="text" />
					</div>
					<div class="field">
						<label for="city">{c.fields.cityOptional}</label>
						<input id="city" name="city" type="text" />
					</div>
					<div class="field">
						<label for="size">{c.fields.sizeOptional}</label>
						<input id="size" name="audience_size" type="text" />
					</div>
					<div class="field">
						<label for="phone">{c.fields.phoneOptional}</label>
						<input id="phone" name="phone" type="tel" autocomplete="tel" />
					</div>
				</fieldset>

				<button type="submit" class="btn btn--accent" id="contact-submit">
					{c.submit}
				</button>

				<p id="contact-result" role="status" aria-live="polite" class="contact-result"></p>
			</form>

			<p class="page-note contact-alt">
				{c.emailAlt} <a href={`mailto:${t.footer.contactEmail}`}>{t.footer.contactEmail}</a>
			</p>
		</div>
	</section>
</SiteLayout>

<script define:vars={{ subjectText: c.subject, successText: c.success, submitText: c.submit }}>
	const form = document.getElementById("contact-form");
	const result = document.getElementById("contact-result");
	const submitBtn = document.getElementById("contact-submit");
	const to = form.dataset.contactEmail;

	form.addEventListener("submit", (event) => {
		event.preventDefault();
		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}
		// Cada campo, con su etiqueta visible, en una línea del cuerpo.
		const lines = [];
		for (const field of form.querySelectorAll("input, textarea")) {
			if (!field.name || !field.value.trim()) continue;
			const label = form.querySelector(`label[for="${field.id}"]`);
			lines.push(`${label ? label.textContent.trim() : field.name}: ${field.value.trim()}`);
		}
		const href =
			`mailto:${to}?subject=${encodeURIComponent(subjectText)}` +
			`&body=${encodeURIComponent(lines.join("\n"))}`;
		window.location.href = href;
		result.textContent = successText;
		result.dataset.state = "success";
		submitBtn.textContent = submitText;
	});
</script>

<style>
	.contact-container {
		max-width: 640px;
		margin-inline: 0;
	}
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.field label {
		font-size: var(--text-xs);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}
	.field input,
	.field textarea {
		background: var(--surface-raised);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		padding: var(--space-3) var(--space-4);
		color: var(--ink);
		font-size: var(--text-base);
		font-family: inherit;
	}
	.field input:focus,
	.field textarea:focus {
		outline: 2px solid var(--focus-ring);
		outline-offset: 1px;
		border-color: var(--focus-ring);
	}
	.field-group {
		border: 0;
		padding: 0;
		margin: 0;
		display: grid;
		gap: var(--space-4);
	}
	.contact-form > .btn {
		align-self: flex-start;
	}
	.contact-form > .btn:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}
	.contact-result {
		font-size: var(--text-sm);
		min-height: 1.5em;
	}
	.contact-result[data-state="success"] {
		color: var(--interactive);
	}
	.contact-result[data-state="error"] {
		color: var(--alerta, #df6a72);
	}
	.contact-alt {
		margin-top: var(--space-8);
	}
	.contact-alt a {
		color: var(--interactive);
	}

	@media (min-width: 640px) {
		.field-group {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
