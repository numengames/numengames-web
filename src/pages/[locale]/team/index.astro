---
import Layout from "@layouts/Layout.astro";
import { getLocaleStaticPaths, type SupportedLocale } from "../../../i18n";

import OriginsSection from "@components/features/team/Origins.astro";
import PartnersSection from "@components/features/team/Partners.astro";
import HeroDesktopSection from "@components/features/team/HeroDesktop.astro";
import ProfilePictureCarouselSection from "@components/features/team/ProfilePictureCarousel.astro";

export const getStaticPaths = getLocaleStaticPaths;

const { locale } = Astro.params;
const currentLocale = (locale as SupportedLocale) || 'en';

const markdownFile = Object.values(import.meta.glob("@pages/content/team.md", { eager: true })) as any[];
const { frontmatter } = markdownFile[0];
---

<Layout title={frontmatter.title} locale={currentLocale}>
	<main class="overflow-x-hidden">
		<HeroDesktopSection textObj={frontmatter.heroSection} class="xl:flex" />
		<ProfilePictureCarouselSection textObj={frontmatter.profiles} />
		<OriginsSection textObj={frontmatter.origins} />
		<PartnersSection textObj={frontmatter.partners} />
	</main>
</Layout>
