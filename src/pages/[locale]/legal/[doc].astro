---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
//
// Páginas legales: /{locale}/legal/notice, /privacy, /cookies y /terms.
//
// El texto es una copia LITERAL de los maestros del archivo numinia-archive
// (legal/LEG-004 aviso legal, LEG-001 privacidad, LEG-003 cookies, LEG-002
// términos), que se sirven desde src/content/legal/. Nada aquí edita el
// texto. Solo se pinta el cuerpo Markdown: el frontmatter (review_flags y
// demás notas internas) nunca llega al visitante. Los maestros dicen ellos
// mismos a qué sitios se aplican, así que no hay nota de alcance; el aviso
// de idioma es cromo de la página, fuera del documento.
// tests/legal-corpus.test.ts fija que las copias siguen siendo idénticas y
// tests/legal-hygiene.test.ts que lo publicado no filtra notas internas.
import SiteLayout from "@layouts/SiteLayout.astro";
import { getDictionary } from "@content/dictionary";
import { localizedPath, type SupportedLocale } from "@lib/locale";
import "@styles/inner-pages.css";
import type { MarkdownInstance } from "astro";

export const prerender = true;
export async function getStaticPaths() {
	const docs = ["notice", "privacy", "cookies", "terms"] as const;
	const locales = ["es", "en"] as const;
	return locales.flatMap((locale) => docs.map((doc) => ({ params: { locale, doc } })));
}

type Doc = "notice" | "privacy" | "cookies" | "terms";
const { locale, doc } = Astro.params as { locale: SupportedLocale; doc: Doc };
const t = getDictionary(locale);
const l = t.legal;

const modules = import.meta.glob<MarkdownInstance<Record<string, unknown>>>(
	"../../../content/legal/*.md",
	{ eager: true },
);
const module = modules[`../../../content/legal/${doc}.md`];
if (!module) throw new Error(`Missing legal corpus file for "${doc}" (src/content/legal/)`);
const { Content, frontmatter } = module;
const title = String(frontmatter["title"] ?? doc);
const version = typeof frontmatter["version"] === "string" ? frontmatter["version"] : undefined;
const updated = typeof frontmatter["updated"] === "string" ? frontmatter["updated"] : undefined;
const descriptions: Record<Doc, string> = {
	notice: t.footer.legalNotice,
	privacy: t.footer.legalPrivacy,
	cookies: t.footer.legalCookies,
	terms: t.footer.legalTerms,
};
const description = descriptions[doc];
---

<SiteLayout title={`Numen Games — ${title}`} description={description} locale={locale} path={`/legal/${doc}`}>
	<section class="page-hero">
		<div class="container">
			<a href={localizedPath("/", locale)} class="legal__back">← {l.back}</a>
			{locale !== "en" && <p class="legal__lang" lang={locale}>{l.onlyInEnglish}</p>}
			<p class="legal__meta">
				{version && <span>{l.versionLabel} {version}</span>}
				{updated && <span>{l.updatedLabel} {updated.slice(0, 10)}</span>}
			</p>
		</div>
	</section>

	<section class="section page-section">
		<div class="container">
			<article class="legal__corpus measure" lang="en" data-legal-doc={doc} data-legal-version={version}>
				<Content />
			</article>
		</div>
	</section>
</SiteLayout>

<style>
	.legal__back {
		display: inline-block;
		margin-bottom: var(--space-6);
		color: var(--ink-muted);
		font-size: var(--text-sm);
		text-decoration: none;
	}
	.legal__back:hover,
	.legal__back:focus-visible {
		color: var(--interactive);
	}
	.legal__lang {
		color: var(--ink-faint);
		font-size: var(--text-sm);
		margin-top: var(--space-3);
	}
	.legal__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-top: var(--space-4);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-faint);
	}
	.legal__corpus {
		line-height: var(--leading-normal);
	}
	.legal__corpus :global(h1) {
		font-size: var(--text-2xl);
		margin-bottom: var(--space-6);
	}
	.legal__corpus :global(h2) {
		font-size: var(--text-xl);
		margin-top: var(--space-8);
		margin-bottom: var(--space-3);
	}
	.legal__corpus :global(h3) {
		font-size: var(--text-lg);
		margin-top: var(--space-6);
		margin-bottom: var(--space-2);
	}
	.legal__corpus :global(p),
	.legal__corpus :global(li) {
		color: var(--ink-muted);
	}
	.legal__corpus :global(blockquote) {
		border-left: 2px solid var(--line-strong);
		padding-left: var(--space-4);
		margin: var(--space-6) 0;
		color: var(--ink-faint);
	}
	.legal__corpus :global(a) {
		color: var(--interactive);
	}
	.legal__corpus :global(hr) {
		border: 0;
		border-top: 1px solid var(--line);
		margin: var(--space-8) 0;
	}
	/* Las tablas anchas (LEG-003 §3) se desplazan dentro de sí mismas en
	   móvil; la página no gana scroll horizontal. */
	.legal__corpus :global(table) {
		display: block;
		overflow-x: auto;
		max-width: 100%;
		border-collapse: collapse;
		width: 100%;
		font-size: var(--text-sm);
	}
	.legal__corpus :global(th),
	.legal__corpus :global(td) {
		border: 1px solid var(--line);
		padding: var(--space-2) var(--space-3);
		text-align: left;
		vertical-align: top;
	}
</style>
