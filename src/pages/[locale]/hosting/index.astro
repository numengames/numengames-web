---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
//
// numen.games/hosting — página de venta del alojamiento de mundos 3D.
// Orden: promesa y datos rápidos · qué alojamos · qué incluye · tabla de
// planes · el día del evento · cómo se contrata (quién y cuándo) ·
// preguntas · solicitud. El formulario, como /contacto, compone un correo
// en el cliente del visitante: sin terceros ni secretos.
import SiteLayout from "@layouts/SiteLayout.astro";
import { HOSTING } from "@content/hosting";
import { getDictionary } from "@content/dictionary";
import { type SupportedLocale } from "@lib/locale";
import "@styles/inner-pages.css";

export const prerender = true;
export async function getStaticPaths() {
	return [{ params: { locale: "es" } }, { params: { locale: "en" } }];
}

const { locale } = Astro.params as { locale: SupportedLocale };
const h = HOSTING[locale];
const contactEmail = getDictionary(locale).footer.contactEmail;
---

<SiteLayout title={`Numen Games — ${h.eyebrow}`} description={h.lead} locale={locale} path="/hosting">
	<section class="hx-hero">
		<div class="container">
			<p class="eyebrow">{h.eyebrow}</p>
			<h1>{h.title}</h1>
			<p class="hx-hero__lead measure">{h.lead}</p>
			<div class="hx-hero__actions">
				<a href="#solicitud" class="btn btn--accent">
					{h.ctaPrimary}
				</a>
				<a href="#planes" class="btn btn--ghost">
					{h.ctaSecondary}
				</a>
			</div>
			<dl class="hx-facts">
				{h.facts.map((f) => (
					<div>
						<dt>{f.value}</dt>
						<dd>{f.label}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	<section class="section page-section">
		<div class="container">
			<h2>{h.fitsTitle}</h2>
			<p class="measure hx-lead">{h.fitsLead}</p>
			<div class="card-grid hx-grid-3">
				{h.fits.map((f) => (
					<div>
						<h3>{f.title}</h3>
						<p>{f.body}</p>
					</div>
				))}
			</div>
			<p class="page-note hx-note">{h.notFit}</p>
		</div>
	</section>

	<section class="section section--raised page-section">
		<div class="container">
			<h2>{h.includedTitle}</h2>
			<ul class="hx-included">
				{h.included.map((i) => (
					<li>
						<h3>{i.title}</h3>
						<p>{i.body}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section page-section" id="planes">
		<div class="container">
			<h2>{h.plansTitle}</h2>
			<p class="measure hx-lead">{h.plansLead}</p>
			<div class="hx-table-wrap">
				<table class="hx-table">
					<thead>
						<tr>
							<th scope="col">
								<span class="visually-hidden">{h.specsFeature}</span>
							</th>
							{h.plans.map((p) => (
								<th scope="col">
									<span class="hx-plan">{p.name}</span>
									<span class="hx-plan__for">{p.forWhom}</span>
								</th>
							))}
						</tr>
					</thead>
					<tbody>
						{h.specs.map((row) => (
							<tr>
								<th scope="row">{row.label}</th>
								{row.values.map((v) => (
									<td>{v}</td>
								))}
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="page-note hx-note">{h.priceNote}</p>
		</div>
	</section>

	<section class="section section--raised page-section">
		<div class="container hx-split">
			<div>
				<h2>{h.eventsTitle}</h2>
				<p class="measure">{h.eventsBody}</p>
			</div>
			<ol class="hx-numbered">
				{h.eventsSteps.map((s) => (
					<li>{s}</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section page-section">
		<div class="container">
			<h2>{h.flowTitle}</h2>
			<p class="measure hx-lead">{h.flowLead}</p>
			<ol class="hx-flow">
				{h.flow.map((s, i) => (
					<li>
						<span class="hx-flow__n" aria-hidden="true">
							{String(i + 1).padStart(2, "0")}
						</span>
						<div class="hx-flow__body">
							<h3>{s.title}</h3>
							<p>{s.body}</p>
						</div>
						<dl class="hx-flow__meta">
							<div>
								<dt>{locale === "en" ? "Who" : "Quién"}</dt>
								<dd>{s.who}</dd>
							</div>
							<div>
								<dt>{locale === "en" ? "When" : "Cuándo"}</dt>
								<dd>{s.when}</dd>
							</div>
						</dl>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section section--raised page-section">
		<div class="container">
			<h2>{h.faqTitle}</h2>
			<div class="hx-faq">
				{h.faq.map((f) => (
					<details>
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="section page-section" id="solicitud">
		<div class="container hx-form-wrap">
			<h2>{h.form.title}</h2>
			<p class="measure hx-lead">{h.form.lead}</p>
			<form id="hosting-form" class="hx-form" data-contact-email={contactEmail} data-subject={h.form.subject} data-success={h.form.success} novalidate>
				{h.form.fields.map((f) => (
					<div class:list={["field", (f.type === "textarea" || f.name === "world_url") && "field--wide"]}>
						<label for={`h-${f.name}`}>{f.label}</label>
						{f.type === "textarea" ? (
							<textarea id={`h-${f.name}`} name={f.name} rows="4" required={f.required}></textarea>
						) : f.type === "select" ? (
							<select id={`h-${f.name}`} name={f.name} required={f.required}>
								<option value="">—</option>
								{f.options?.map((o) => (
									<option value={o}>{o}</option>
								))}
							</select>
						) : (
							<input id={`h-${f.name}`} name={f.name} type={f.type} required={f.required} />
						)}
						{f.hint && <small>{f.hint}</small>}
					</div>
				))}
				<div class="field--wide hx-form__foot">
					<button type="submit" class="btn btn--accent">
						{h.form.submit}
					</button>
					<p class="page-note">{h.form.privacy}</p>
				</div>
				<p id="hosting-result" role="status" aria-live="polite" class="field--wide hx-result"></p>
			</form>
		</div>
	</section>
</SiteLayout>

<script>
	const form = document.getElementById("hosting-form") as HTMLFormElement | null;
	const result = document.getElementById("hosting-result");
	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}
		const lines: string[] = [];
		for (const field of form.querySelectorAll<HTMLInputElement>("input, textarea, select")) {
			if (!field.name || !field.value.trim()) continue;
			const label = form.querySelector(`label[for="${field.id}"]`);
			lines.push(`${label ? label.textContent?.trim() : field.name}: ${field.value.trim()}`);
		}
		const { contactEmail, subject, success } = form.dataset;
		window.location.href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject ?? "")}` + `&body=${encodeURIComponent(lines.join("\n"))}`;
		if (result) {
			result.textContent = success ?? "";
			result.dataset.state = "success";
		}
	});
</script>

<style>
	.hx-hero {
		padding-block: var(--space-24) var(--space-16);
		border-bottom: 1px solid var(--line);
	}
	.hx-hero h1 {
		font-size: var(--text-3xl);
		line-height: 1.05;
		max-width: 18ch;
		margin-block: var(--space-4) var(--space-6);
	}
	.hx-hero__lead {
		font-size: var(--text-lg);
		color: var(--ink-muted);
	}
	.hx-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-top: var(--space-8);
	}
	.hx-facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--space-6);
		margin: var(--space-16) 0 0;
		padding-top: var(--space-8);
		border-top: 1px solid var(--line);
	}
	.hx-facts dt {
		font-family: var(--font-titular);
		font-size: var(--text-xl);
		color: var(--ink);
	}
	.hx-facts dd {
		margin: var(--space-2) 0 0;
		color: var(--ink-muted);
		font-size: var(--text-sm);
	}

	.hx-lead {
		color: var(--ink-muted);
		margin-bottom: var(--space-8);
	}
	.hx-note {
		margin-top: var(--space-6);
	}
	.hx-grid-3 {
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
	}

	.hx-included {
		list-style: none;
		padding: 0;
		margin: var(--space-8) 0 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: var(--space-8) var(--space-12);
	}
	.hx-included li {
		border-top: 2px solid var(--accent);
		padding-top: var(--space-4);
	}
	.hx-included h3 {
		font-size: var(--text-lg);
		margin-bottom: var(--space-2);
	}
	.hx-included p {
		color: var(--ink-muted);
	}

	.hx-table-wrap {
		overflow-x: auto;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-frame);
	}
	.hx-table {
		width: 100%;
		border-collapse: collapse;
		min-width: 640px;
	}
	.hx-table th,
	.hx-table td {
		text-align: left;
		vertical-align: top;
		padding: var(--space-4) var(--space-6);
		border-bottom: 1px solid var(--line);
	}
	.hx-table tbody tr:last-child > * {
		border-bottom: 0;
	}
	.hx-table thead th {
		background: var(--surface-raised);
		width: 37%;
	}
	.hx-table thead th:first-child {
		width: 26%;
	}
	.hx-table tbody th {
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		font-weight: 400;
		color: var(--ink-faint);
		padding-top: calc(var(--space-4) + 0.25em);
	}
	.hx-table td {
		color: var(--ink);
	}
	.hx-plan {
		display: block;
		font-family: var(--font-titular);
		font-size: var(--text-lg);
		font-weight: 500;
	}
	.hx-plan__for {
		display: block;
		margin-top: var(--space-2);
		font-weight: 400;
		font-size: var(--text-sm);
		color: var(--ink-muted);
	}

	.hx-split {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-8);
	}
	@media (min-width: 860px) {
		.hx-split {
			grid-template-columns: 1fr 1fr;
			align-items: start;
		}
	}
	.hx-numbered {
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: step;
		display: grid;
		gap: var(--space-4);
	}
	.hx-numbered li {
		counter-increment: step;
		display: grid;
		grid-template-columns: 2.5rem 1fr;
		gap: var(--space-3);
		color: var(--ink-muted);
	}
	.hx-numbered li::before {
		content: counter(step, decimal-leading-zero);
		font-family: var(--font-mono);
		color: var(--accent);
	}

	.hx-flow {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}
	.hx-flow > li {
		display: grid;
		grid-template-columns: 3rem 1fr;
		gap: var(--space-2) var(--space-6);
		padding-block: var(--space-6);
		border-bottom: 1px solid var(--line);
	}
	@media (min-width: 860px) {
		.hx-flow > li {
			grid-template-columns: 3rem 1fr 18rem;
		}
	}
	.hx-flow__n {
		font-family: var(--font-mono);
		color: var(--accent);
		font-size: var(--text-lg);
	}
	.hx-flow__body h3 {
		font-size: var(--text-lg);
		margin-bottom: var(--space-2);
	}
	.hx-flow__body p {
		color: var(--ink-muted);
	}
	.hx-flow__meta {
		grid-column: 2;
		margin: 0;
		display: grid;
		gap: var(--space-2);
	}
	@media (min-width: 860px) {
		.hx-flow__meta {
			grid-column: 3;
		}
	}
	.hx-flow__meta div {
		display: grid;
		grid-template-columns: 5rem 1fr;
	}
	.hx-flow__meta dt {
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-faint);
		padding-top: 0.3em;
	}
	.hx-flow__meta dd {
		margin: 0;
		font-size: var(--text-sm);
	}

	.hx-faq {
		display: grid;
		gap: var(--space-3);
		max-width: 60rem;
	}
	.hx-faq details {
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-frame);
		padding: var(--space-4) var(--space-6);
		background: var(--surface);
	}
	.hx-faq summary {
		cursor: pointer;
		font-weight: 500;
	}
	.hx-faq details p {
		margin-top: var(--space-3);
		color: var(--ink-muted);
	}

	.hx-form-wrap {
		max-width: 52rem;
	}
	.hx-form {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--space-6);
	}
	.field--wide {
		grid-column: 1 / -1;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.field label {
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}
	.field input,
	.field select,
	.field textarea {
		background: var(--surface-raised);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-control);
		padding: var(--space-3) var(--space-4);
		color: var(--ink);
		font-size: var(--text-base);
		font-family: inherit;
	}
	.field input:focus,
	.field select:focus,
	.field textarea:focus {
		outline: 2px solid var(--focus-ring);
		outline-offset: 1px;
		border-color: var(--focus-ring);
	}
	.field small {
		color: var(--ink-faint);
		font-size: var(--text-xs);
	}
	.hx-form__foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4) var(--space-6);
	}
	.hx-result {
		font-size: var(--text-sm);
		min-height: 1.5em;
	}
	.hx-result[data-state="success"] {
		color: var(--interactive);
	}
</style>
