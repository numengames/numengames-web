---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
//
// numen.games/hosting — página de venta del alojamiento de mundos 3D.
// Orden: promesa y datos rápidos · qué alojamos · qué incluye · tabla de
// planes · el día del evento · cómo se contrata (quién y cuándo) ·
// preguntas · solicitud (RequestForm). Estilos en sales-page.css.
import SiteLayout from "@layouts/SiteLayout.astro";
import { HOSTING } from "@content/hosting";
import { type SupportedLocale } from "@lib/locale";
import RequestForm from "@components/site/RequestForm.astro";
import "@styles/inner-pages.css";
import "@styles/sales-page.css";

export const prerender = true;
export async function getStaticPaths() {
	return [{ params: { locale: "es" } }, { params: { locale: "en" } }];
}

const { locale } = Astro.params as { locale: SupportedLocale };
const h = HOSTING[locale];
---

<SiteLayout title={`Numen Games — ${h.eyebrow}`} description={h.lead} locale={locale} path="/hosting">
	<section class="hx-hero">
		<div class="container">
			<p class="eyebrow">{h.eyebrow}</p>
			<h1>{h.title}</h1>
			<p class="hx-hero__lead measure">{h.lead}</p>
			<div class="hx-hero__actions">
				<a href="#solicitud" class="btn btn--accent">
					{h.ctaPrimary}
				</a>
				<a href="#planes" class="btn btn--ghost">
					{h.ctaSecondary}
				</a>
			</div>
			<dl class="hx-facts">
				{h.facts.map((f) => (
					<div>
						<dt>{f.value}</dt>
						<dd>{f.label}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	<section class="section page-section">
		<div class="container">
			<h2>{h.fitsTitle}</h2>
			<p class="measure hx-lead">{h.fitsLead}</p>
			<div class="card-grid hx-grid-3">
				{h.fits.map((f) => (
					<div>
						<h3>{f.title}</h3>
						<p>{f.body}</p>
					</div>
				))}
			</div>
			<p class="page-note hx-note">{h.notFit}</p>
		</div>
	</section>

	<section class="section section--raised page-section">
		<div class="container">
			<h2>{h.includedTitle}</h2>
			<ul class="hx-included">
				{h.included.map((i) => (
					<li>
						<h3>{i.title}</h3>
						<p>{i.body}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section page-section" id="planes">
		<div class="container">
			<h2>{h.plansTitle}</h2>
			<p class="measure hx-lead">{h.plansLead}</p>
			<div class="hx-table-wrap">
				<table class="hx-table">
					<thead>
						<tr>
							<th scope="col">
								<span class="visually-hidden">{h.specsFeature}</span>
							</th>
							{h.plans.map((p) => (
								<th scope="col">
									<span class="hx-plan">{p.name}</span>
									<span class="hx-plan__for">{p.forWhom}</span>
								</th>
							))}
						</tr>
					</thead>
					<tbody>
						{h.specs.map((row) => (
							<tr>
								<th scope="row">{row.label}</th>
								{row.values.map((v) => (
									<td>{v}</td>
								))}
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="page-note hx-note">{h.priceNote}</p>
		</div>
	</section>

	<section class="section section--raised page-section">
		<div class="container hx-split">
			<div>
				<h2>{h.eventsTitle}</h2>
				<p class="measure">{h.eventsBody}</p>
			</div>
			<ol class="hx-numbered">
				{h.eventsSteps.map((s) => (
					<li>{s}</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section page-section">
		<div class="container">
			<h2>{h.flowTitle}</h2>
			<p class="measure hx-lead">{h.flowLead}</p>
			<ol class="hx-flow">
				{h.flow.map((s, i) => (
					<li>
						<span class="hx-flow__n" aria-hidden="true">
							{String(i + 1).padStart(2, "0")}
						</span>
						<div class="hx-flow__body">
							<h3>{s.title}</h3>
							<p>{s.body}</p>
						</div>
						<dl class="hx-flow__meta">
							<div>
								<dt>{locale === "en" ? "Who" : "Quién"}</dt>
								<dd>{s.who}</dd>
							</div>
							<div>
								<dt>{locale === "en" ? "When" : "Cuándo"}</dt>
								<dd>{s.when}</dd>
							</div>
						</dl>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section section--raised page-section">
		<div class="container">
			<h2>{h.faqTitle}</h2>
			<div class="hx-faq">
				{h.faq.map((f) => (
					<details>
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<RequestForm form={h.form} id="solicitud" />
</SiteLayout>
