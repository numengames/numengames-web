---
import type { GetStaticPaths } from 'astro';
import { getLocaleStaticPaths, type SupportedLocale } from "../../../i18n";
import Layout from "@layouts/Layout.astro";

import AboutSection from "./_About.astro";
import GallerySection from "./_Gallery.astro";
import HeroDesktopSection from "./_HeroDesktop.astro";

export const getStaticPaths = getLocaleStaticPaths;

const { locale } = Astro.params;
const currentLocale = (locale as SupportedLocale) || 'en';

const markdownFile = Object.values(import.meta.glob("@pages/content/numinia.md", { eager: true })) as any[];
const { frontmatter } = markdownFile[0];
---

<Layout title={frontmatter.title} locale={currentLocale}>
	<main>
		<HeroDesktopSection textObj={frontmatter.heroSection} />
		<AboutSection textObj={frontmatter.aboutSection} />
		<GallerySection textObj={frontmatter.gallerySection} />
	</main>
</Layout>
