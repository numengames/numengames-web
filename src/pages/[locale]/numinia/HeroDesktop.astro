---
import type { GetStaticPaths } from 'astro';
import { getLocaleStaticPaths, type SupportedLocale } from "../../../i18n";
import Container from "@components/Container.svelte";

import HeroDesktopNuminia from "./HeroDesktop.svelte";

interface Props { textObj: any }
const { textObj } = Astro.props || {};

export const getStaticPaths = getLocaleStaticPaths;

const { locale } = Astro.params;
const currentLocale = (locale as SupportedLocale) || 'en';
---

<Container
	className="h-[calc(100vh-40px)] flex flex-col items-center justify-center pt-24 xl:pt-28"
	bgColor="bg-[#171717]">
	<HeroDesktopNuminia {textObj} client:only="svelte" />
</Container>
