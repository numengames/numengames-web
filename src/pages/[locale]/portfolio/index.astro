---
import type { GetStaticPaths } from "astro";

import Layout from "@layouts/Layout.astro";
import { getLocaleStaticPaths, type SupportedLocale } from "../../../i18n";

import Container from "@components/Container.svelte";

import PortfolioHero from "./PortfolioHero.svelte";
import PortfolioCards from "./PortfolioCards.svelte";

export const getStaticPaths: GetStaticPaths = getLocaleStaticPaths;

const { locale } = Astro.params;
const currentLocale = (locale as SupportedLocale) || "en";
---

<Layout title="Numen Games - Portfolio" locale={currentLocale}>
  <!-- Hero -->
  <Container
    className="flex flex-col items-center justify-center pt-16 xl:pt-20 pb-6"
    bgColor="bg-[#171717]"
  >
    <PortfolioHero client:only="svelte" />
  </Container>

  <!-- Cards -->
  <Container
    className="flex flex-col items-center justify-center pb-20"
    bgColor="bg-[#141414]"
  >
    <PortfolioCards client:only="svelte" />
  </Container>
</Layout>