---
import type { ContentData, ContentModule } from "@app-types/content";
import { getLocaleStaticPaths, type SupportedLocale } from "../../../i18n";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.svelte";
import BracketedContent from "@components/BracketedContent.svelte";

export const getStaticPaths = getLocaleStaticPaths;

const { locale } = Astro.params;
const currentLocale = (locale as SupportedLocale) || "en";

const markdownFile = Object.values(import.meta.glob("@pages/content/manifesto.md", { eager: true })) as ContentModule[];
const { frontmatter } = markdownFile[0];
---

<Layout title={frontmatter.title} locale={currentLocale}>
	<main>
		<article>
			<Container className="text-arena flex flex-col items-center relative bg-[#1E1A17]">
				<div class="pt-20 md:pt-32 lg:pt-44 mb-4 w-[90%] md:w-[80%] lg:max-w-[45%]">
					<div class="relative w-full aspect-[8/4]">
						<div class="absolute top-0 right-0 p-2 md:p-4 flex items-center">
							<img src="/icons/book-open-text.svg" alt="book_open_text_icon" class="mr-2 w-4 h-4 md:w-5 md:h-5" />
							<span class="text-arena text-xs md:text-sm px-2 md:px-4 py-1 md:py-2 z-10 rounded-md border border-arena/10 bg-nocturno-lineaFuerte/60">10 min read</span>
						</div>
						<img alt="Numen Games culture and gamification manifesto" src="/assets/hero-culture.webp" class:list="w-full h-full object-cover" />
						<div class="absolute inset-0 bg-gradient-to-b from-transparent to-nocturno-base"></div>
						<div class="absolute bottom-0 left-0 w-full flex flex-col items-start justify-center p-4">
							<BracketedContent text={frontmatter.header?.bracketedContent} />
							<h3 class="mt-2 text-xl md:text-2xl lg:text-3xl font-base leading-tight md:leading-[2rem] text-arena">
								{frontmatter.header?.title}
							</h3>
						</div>
					</div>
					{
						frontmatter.sections?.map((section: ContentData, index: number) => (
							<section class={`my-6 md:my-8 lg:my-10 px-2 md:px-4 ${index === 0 ? "mt-4 md:mt-6" : ""}`}>
								{section.title && <h2 class="text-xs md:text-sm font-medium leading-[1.5] md:leading-[27px] text-ambar mb-3 md:mb-5 uppercase font-geistMono tracking-[1.6px]">{section.title}</h2>}
								{section.content.map((paragraph: string) => (
									<p class="font-light text-sm md:text-base leading-[1.5] md:leading-[27px] text-arena/75 mb-4 md:mb-8">{paragraph}</p>
								))}
								{section.bullets && (
									<ul>
										{section.bullets.map((bullet: string) => (
											<li class="font-light text-sm md:text-base leading-[1.5] md:leading-[27px] text-arena/75 mb-3 md:mb-4 flex items-center">
												<img src="/icons/check.svg" alt="check_icon" class="mr-3 md:mr-4 w-4 h-4 md:w-5 md:h-5 p-1 bg-interactivo rounded-full" />
												{bullet}
											</li>
										))}
									</ul>
								)}
							</section>
						))
					}
				</div>
			</Container>
		</article>
	</main>
</Layout>
