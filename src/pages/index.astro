---
import { getBrowserLanguage, DEFAULT_LOCALE } from "../i18n";

// Simple server-side redirect to localized version
const locale = DEFAULT_LOCALE;
---

<meta http-equiv="refresh" content={`0;url=/${locale}`} />

<script>
	// Client-side navigation to detect browser language
	const detectedLocale = localStorage.getItem('locale') || 
		(navigator.language.startsWith('es') ? 'es' : 'en');
	
	window.location.href = `/${detectedLocale}`;
</script>
