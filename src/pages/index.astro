---
import Layout from "@layouts/Layout.astro";
import MobileHeroSection from "@components/sections/hero/HeroMobile.astro";
import DesktopHeroSection from "@components/sections/hero/HeroDesktop.astro";
import ServicesMobileSection from "@components/sections/hero/_ServicesMobile.svelte";
import WhyNumenMobileSection from "@components/sections/hero/_WhyNumenMobile.svelte";
import ServicesDesktopSection from "@components/sections/hero/_ServicesDesktop.svelte";
import WhyNumenDesktopSection from "@components/sections/hero/_WhyNumenDesktop.svelte";
import WorkProcessMobileSection from "@components/sections/hero/_WorkProcessMobile.svelte";
import WorkProcessDesktopSection from "@components/sections/hero/_WorkProcessDesktop.svelte";
import TestimonialsMobileSection from "@components/sections/hero/_TestimonialsMobile.svelte";
import TestimonialsDesktopSection from "@components/sections/hero/_TestimonialsDesktop.svelte";
---

<Layout title="Numen Games">
	<main class="max-w-[1920px] m-auto">
		<DesktopHeroSection class="xl:flex" />
		<MobileHeroSection class="xl:hidden" />
		<ServicesMobileSection client:only="svelte" />
		<ServicesDesktopSection client:only="svelte" />
		<WhyNumenMobileSection client:only="svelte" />
		<WhyNumenDesktopSection client:only="svelte" />
		<WorkProcessMobileSection client:only="svelte" />
		<WorkProcessDesktopSection client:only="svelte" />
		<TestimonialsMobileSection client:only="svelte" />
		<TestimonialsDesktopSection client:only="svelte" />
	</main>
</Layout>

