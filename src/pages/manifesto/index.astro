---
import { Picture } from "astro:assets";

import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.svelte";

import BracketedContent from "@components/BracketedContent.svelte";

const markdownFile = await Astro.glob("../content/manifesto.md");
const { frontmatter } = markdownFile[0];
---

<Layout title={frontmatter.title}>
	<main>
		<article>
			<Container
				class="text-basics-white flex flex-col items-center relative bg-[#171717]">
				<div class="mt-24 sm:mt-32 md:mt-44 mb-4 w-[90%] md:w-[70%] lg:w-[60%] xl:w-[45%]">
					<div class="relative w-full aspect-[4/3] sm:aspect-[16/9] md:aspect-[8/4]">
						<div class="absolute top-0 right-0 p-4 flex items-center">
							<img
								src="/icons/book-open-text.svg"
								alt="book_open_text_icon"
								class="mr-2 w-5 h-5"
							/>
							<span
								class="text-white text-xs sm:text-sm px-2 sm:px-4 py-1 sm:py-2 z-10 rounded-md border border-white/10 bg-basics-darkGray/60"
								>10 min read</span
							>
						</div>
						<img
							alt="Descripción de la imagen"
							src="/assets/hero-culture.webp"
							class:list="w-full h-full object-cover"
						/>
						<div
							class="absolute inset-0 bg-gradient-to-b from-transparent to-black">
						</div>
						<div
							class="absolute bottom-0 left-0 w-full flex flex-col items-start justify-center p-4">
							<BracketedContent text={frontmatter.header?.bracketedContent} />
							<h3 class="mt-2 text-xl sm:text-2xl md:text-3xl font-base leading-[1.5rem] sm:leading-[2rem] text-white">
								{frontmatter.header?.title}
							</h3>
						</div>
					</div>
					{
						frontmatter.sections?.map((section, index) => (
							<section class={`my-6 sm:my-8 md:my-10 px-2 sm:px-3 md:px-4 ${index === 0 ? "mt-4 sm:mt-6" : ""}`}>
								{section.title && (
									<h2 class="text-xs sm:text-sm font-medium leading-[24px] sm:leading-[27px] text-primary-coralRed mb-3 sm:mb-5 uppercase font-IBMPlexMono tracking-[1.6px]">
										{section.title}
									</h2>
								)}
								{section.content.map((paragraph, index) => (
									<p class="text-sm sm:text-base font-light leading-[24px] sm:leading-[27px] text-primary-beige/75 mb-6 sm:mb-8">
										{paragraph}
									</p>
								))}
								{section.bullets && (
									<ul>
										{section.bullets.map((bullet, index) => (
											<li class="text-sm sm:text-base font-light leading-[24px] sm:leading-[27px] text-primary-beige/75 mb-3 sm:mb-4 flex items-center">
												<img
													src="/icons/check.svg"
													alt="check_icon"
													class="mr-3 sm:mr-4 w-4 h-4 sm:w-5 sm:h-5 p-1 bg-primary-coralRed rounded-full"
												/>
												{bullet}
											</li>
										))}
									</ul>
								)}
							</section>
						))
					}
				</div>
			</Container>
		</article>
	</main>
</Layout>
