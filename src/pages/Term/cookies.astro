---
---

<main class="terms-root">
	<section class="terms-card">
		<header class="terms-header">
			<h1 class="terms-title">Cookie Policy</h1>
			<p class="terms-meta">Last updated: 2024</p>
		</header>

		<div class="terms-scroll">
			<section class="terms-section">
				<h2 class="terms-heading">What are cookies?</h2>
				<p>
					This Cookie Policy explains what cookies are and how we use them, the types of cookies
					we use, i.e., the information we collect using cookies and how this information is used,
					and how to manage cookie settings.
				</p>
				<p>
					Cookies are small text files that are used to store small pieces of information. They
					are stored on your device when the website is loaded on your browser. These cookies help
					us make the website function properly, make it more secure, provide a better user
					experience, and understand how the website works and analyze what works and what needs
					improvement.
				</p>
			</section>

			<section class="terms-section">
				<h2 class="terms-heading">How do we use cookies?</h2>
				<p>
					Like most online services, our website uses first-party and third-party cookies for
					several purposes. The first-party cookies are mostly necessary for the website to
					function properly and do not collect any personal data that can identify you.
					Third-party cookies used on our website are primarily to understand how the website
					functions, how you interact with our website, maintaining the security of our services,
					providing advertisements that are relevant to you, and ultimately providing you with a
					better user experience and helping speed up your future interactions with our website.
				</p>
			</section>

			<section class="terms-section">
				<h2 class="terms-heading">Managing cookie preferences</h2>
				<p>
					You can change your cookie preferences at any time by clicking on the button above.
					This will allow you to revisit the cookie consent banner and change your preferences or
					withdraw your consent immediately.
				</p>
				<p>
					Moreover, different browsers offer different methods to block and delete cookies used
					by websites. You can change your browser settings to block or delete cookies. Below are
					links to support documents on how to manage and delete cookies from major web browsers.
				</p>
				<ul class="terms-list">
					<li>
						<strong>Chrome:</strong>{" "}
						<a href="https://support.google.com/accounts/answer/32050" target="_blank" rel="noopener noreferrer" class="terms-link">
							https://support.google.com/accounts/answer/32050
						</a>
					</li>
					<li>
						<strong>Safari:</strong>{" "}
						<a href="https://support.apple.com/en-in/guide/safari/sfri11471/mac" target="_blank" rel="noopener noreferrer" class="terms-link">
							https://support.apple.com/en-in/guide/safari/sfri11471/mac
						</a>
					</li>
					<li>
						<strong>Firefox:</strong>{" "}
						<a href="https://support.mozilla.org/en-US/kb/clear-cookies-and-site-data-firefox" target="_blank" rel="noopener noreferrer" class="terms-link">
							https://support.mozilla.org/en-US/kb/clear-cookies-and-site-data-firefox
						</a>
					</li>
					<li>
						<strong>Internet Explorer:</strong>{" "}
						<a href="https://support.microsoft.com/en-us/topic/how-to-delete-cookie-files-in-internet-explorer-bca9446f-d873-78de-77ba-d42645fa52fc" target="_blank" rel="noopener noreferrer" class="terms-link">
							https://support.microsoft.com/en-us/topic/how-to-delete-cookie-files-in-internet-explorer-bca9446f-d873-78de-77ba-d42645fa52fc
						</a>
					</li>
				</ul>
				<p>If you use any other browser, please check the official documentation of your browser.</p>
			</section>
		</div>

		<div class="terms-footer">
			<button type="button" id="cookies-close-btn" class="terms-button">
				Close
			</button>
		</div>
	</section>
</main>

<style>
	:global(body) {
		margin: 0;
		font-family: "Geist", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
	}

	.terms-root {
		min-height: 100vh;
		background-color: #05050f;
		color: #f4ead7;
		font-family: "Geist", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		padding: 1.5rem;
	}

	@media (min-width: 768px) {
		.terms-root {
			padding: 2rem 3rem;
		}
	}

	.terms-card {
		max-width: 960px;
		margin: 0 auto;
		background: rgba(255, 255, 255, 0.03);
		border-radius: 0.75rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: 0 0 40px rgba(255, 255, 255, 0.18);
		padding: 1.5rem 1.75rem;
		display: flex;
		flex-direction: column;
		height: 90vh;
	}

	@media (min-width: 768px) {
		.terms-card {
			padding: 2rem 2.25rem;
		}
	}

	.terms-header {
		margin-bottom: 0.75rem;
	}

	@media (min-width: 768px) {
		.terms-header {
			margin-bottom: 1.25rem;
		}
	}

	.terms-title {
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.03em;
		margin: 0;
	}

	@media (min-width: 768px) {
		.terms-title {
			font-size: 1.875rem;
		}
	}

	.terms-meta {
		margin-top: 0.4rem;
		font-size: 0.8rem;
		color: rgba(244, 234, 215, 0.7);
	}

	@media (min-width: 768px) {
		.terms-meta {
			font-size: 0.9rem;
		}
	}

	.terms-scroll {
		flex: 1;
		overflow-y: auto;
		padding-right: 0.75rem;
		margin-right: -0.25rem;
		scrollbar-width: thin;
		scrollbar-color: rgba(244, 234, 215, 0.4) transparent;
		font-size: 0.9rem;
		line-height: 1.6;
	}

	@media (min-width: 768px) {
		.terms-scroll {
			font-size: 1rem;
		}
	}

	.terms-scroll::-webkit-scrollbar {
		width: 6px;
	}

	.terms-scroll::-webkit-scrollbar-track {
		background: transparent;
	}

	.terms-scroll::-webkit-scrollbar-thumb {
		background-color: rgba(244, 234, 215, 0.4);
		border-radius: 999px;
	}

	.terms-section {
		margin-bottom: 1.5rem;
	}

	.terms-heading {
		font-size: 1.1rem;
		font-weight: 600;
		margin: 0 0 0.5rem 0;
		color: #ffffff;
	}

	@media (min-width: 768px) {
		.terms-heading {
			font-size: 1.25rem;
		}
	}

	p {
		margin: 0 0 0.5rem 0;
		color: rgba(244, 234, 215, 0.9);
	}

	.terms-list {
		margin: 0.25rem 0 0.75rem 1.25rem;
		padding: 0;
		list-style: disc;
		color: rgba(244, 234, 215, 0.9);
	}

	.terms-list li {
		margin-bottom: 0.5rem;
	}

	.terms-link {
		color: #D9B86A;
		text-decoration: underline;
		text-underline-offset: 2px;
		word-break: break-all;
	}

	.terms-link:hover {
		color: #e8cc85;
	}

	.terms-footer {
		margin-top: 0.75rem;
		display: flex;
		justify-content: flex-end;
	}

	@media (min-width: 768px) {
		.terms-footer {
			margin-top: 1rem;
		}
	}

	.terms-button {
		background: #1A1A1A;
		border: 1px solid #2A2A2A;
		border-radius: 0.75rem;
		color: #ffffff;
		font-size: 0.875rem;
		font-weight: 500;
		padding: 0.6rem 1.4rem;
		cursor: pointer;
		transition: all 0.3s;
		box-shadow: 0 0 20px 3px rgba(217, 184, 106, 0.35);
	}

	@media (min-width: 768px) {
		.terms-button {
			font-size: 1rem;
			padding: 0.75rem 1.75rem;
		}
	}

	.terms-button:hover {
		box-shadow: 0 0 30px 6px rgba(217, 184, 106, 0.75);
	}
</style>

<script is:inline>
	const btn = document.getElementById("cookies-close-btn");

	if (btn) {
		btn.addEventListener("click", () => {
			if (window.parent) {
				window.parent.postMessage({ action: "close-cookies" }, "*");
			}
		});
	}
</script>
