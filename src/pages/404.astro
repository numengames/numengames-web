---
// 404 del sitio reconstruido.
//
// Es el único 404 que sirve Cloudflare: wrangler.jsonc fija
// not_found_handling: "404-page", que busca /404.html en la raíz del
// directorio de assets. El 404 anterior era el del catálogo retirado
// (fondo de estrellas, "Whoops! Lost in space?", enlaces a Pricing y
// Portfolio) — ofrecía salidas que ahora son 301.
//
// En español porque es el idioma por defecto del sitio (DEFAULT_LOCALE)
// y una URL rota puede no llevar prefijo de idioma del que deducirlo.
import SiteLayout from "@layouts/SiteLayout.astro";
import { DEFAULT_LOCALE } from "@lib/locale";
---

<SiteLayout
	title="Numen Games — Página no encontrada"
	description="La página que buscas no existe o ha cambiado de dirección."
	locale={DEFAULT_LOCALE}
	path="/"
>
	<section class="page-hero">
		<div class="container">
			<p class="notfound__code">404</p>
			<h1>Esta página no existe</h1>
			<p class="page-hero__lead measure">
				Puede que la dirección haya cambiado o que el enlace esté mal
				copiado. Desde aquí puedes seguir:
			</p>
			<ul class="notfound__links">
				<li><a href="/es/">Inicio</a></li>
				<li><a href="/es/experiencias/">Eventos</a></li>
				<li><a href="/es/formacion/">Formación</a></li>
				<li><a href="/es/hosting/">Mundos 3D</a></li>
				<li><a href="/es/contacto/">Contacto</a></li>
			</ul>
		</div>
	</section>
</SiteLayout>

<style>
	.notfound__code {
		font-family: var(--font-mono);
		font-size: var(--text-2xl);
		color: var(--ink-faint);
		margin-bottom: var(--space-2);
	}
	.notfound__links {
		list-style: none;
		margin: var(--space-8) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-6);
	}
	.notfound__links a {
		color: var(--interactive);
	}
</style>
