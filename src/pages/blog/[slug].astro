---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} — Numen Games`}>
  <article class="min-h-screen px-4 lg:px-10 py-24 lg:py-32 max-w-3xl mx-auto">

    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-xs font-medium tracking-[0.18em] uppercase text-[#D9B86A]/80">
          {entry.data.category}
        </span>
        <span class="text-white/20">·</span>
        <time class="text-xs text-white/40" datetime={entry.data.publishDate.toISOString()}>
          {entry.data.publishDate.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
        </time>
        <span class="text-white/20">·</span>
        <span class="text-xs text-white/40">{entry.data.author}</span>
      </div>

      <h1 class="text-3xl lg:text-5xl font-medium text-white leading-tight tracking-tight">
        {entry.data.title}
      </h1>

      <p class="mt-5 text-lg text-white/50 leading-relaxed">
        {entry.data.excerpt}
      </p>

      {entry.data.image && (
        <div class="mt-10 w-full rounded-2xl overflow-hidden border border-[rgba(217,184,106,0.14)]">
          <img
            src={entry.data.image}
            alt={entry.data.title}
            class="w-full h-64 lg:h-80 object-cover"
          />
        </div>
      )}
    </div>

    <div class="prose prose-invert prose-lg max-w-none
      prose-headings:text-white prose-headings:font-medium prose-headings:tracking-tight
      prose-p:text-white/65 prose-p:leading-relaxed
      prose-strong:text-[#D9B86A] prose-strong:font-medium
      prose-a:text-[#D9B86A] prose-a:no-underline hover:prose-a:underline
      prose-li:text-white/65
      prose-hr:border-[rgba(217,184,106,0.14)]">
      <Content />
    </div>

    <div class="mt-16 pt-8 border-t border-[rgba(217,184,106,0.14)] flex items-center justify-between">
      <div class="flex flex-wrap gap-2">
        {entry.data.tags.map((tag) => (
          <span class="text-xs px-2 py-1 rounded border border-[rgba(217,184,106,0.12)] text-white/40">
            #{tag}
          </span>
        ))}
      </div>
      <a
        href="/blog"
        class="text-sm text-[#D9B86A]/70 hover:text-[#D9B86A] transition-colors">
        ← Back to Blog
      </a>
    </div>

  </article>
</Layout>
