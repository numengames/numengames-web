---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { getLocaleFromURL, DEFAULT_LOCALE } from "../../i18n";
import { getBlogTranslations } from "../../i18n/translations/blog";

const currentLocale = getLocaleFromURL(Astro.url.pathname) || DEFAULT_LOCALE;
const t = getBlogTranslations(currentLocale);

const posts = (await getCollection("blog")).sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<Layout title="Blog — Numen Games">
  <section class="min-h-screen px-4 lg:px-10 py-24 lg:py-32 max-w-7xl mx-auto">

    <div class="mb-14 lg:mb-20">
      <p class="text-xs font-medium tracking-[0.2em] uppercase text-[#D9B86A]/70 mb-3 mt-8 lg:mt-16">
        {t.label}
      </p>
      <h1 class="text-4xl lg:text-6xl font-medium text-white tracking-tight">
        {t.heading}
      </h1>
      <p class="mt-4 text-base text-white/50 max-w-xl">
        {t.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post: CollectionEntry<"blog">) => (
        <a
          href={`/blog/${post.slug}`}
          class="blog-card group flex flex-col h-full border border-[rgba(217,184,106,0.14)] rounded-2xl overflow-hidden bg-[rgba(20,20,20,0.6)] transition-all duration-300">

          {post.data.image && (
            <div class="w-full h-48 overflow-hidden">
              <img
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
          )}

          <div class="flex flex-col flex-1 p-6 gap-4">
            <div class="flex items-center gap-3">
              <span class="text-xs font-medium tracking-[0.15em] uppercase text-[#D9B86A]/80">
                {post.data.category}
              </span>
              <span class="text-white/20">·</span>
              <time class="text-xs text-white/40" datetime={post.data.publishDate.toISOString()}>
                {post.data.publishDate.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}
              </time>
            </div>

            <h2 class="text-lg font-medium text-white leading-snug group-hover:text-[#D9B86A] transition-colors duration-200">
              {post.data.title}
            </h2>

            <p class="text-sm text-white/50 leading-relaxed line-clamp-3 flex-1">
              {post.data.excerpt}
            </p>

            <div class="flex flex-wrap gap-2 mt-auto pt-2">
              {post.data.tags.slice(0, 3).map((tag: string) => (
                <span class="text-xs px-2 py-1 rounded border border-[rgba(217,184,106,0.12)] text-white/40">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>

  </section>
</Layout>

<style>
  .blog-card:hover {
    box-shadow:
      0 0 25px 4px rgba(217, 184, 106, 0.45),
      0 0 10px rgba(217, 184, 106, 0.25),
      0 0 4px rgba(217, 184, 106, 0.15);
    transform: translateY(-2px);
    border-color: rgba(217, 184, 106, 0.35);
  }
</style>
