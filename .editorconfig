# DEV-003 (STD-015): shared editor settings, committed.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2
# No wrapping by width: prettier reads this as printWidth = infinity, the
# same setting nwos-deploy uses, so the scripts the two repositories share
# stay byte-identical under both formatters.
max_line_length = off

# Markdown: trailing whitespace is significant (two spaces = line break).
[*.md]
trim_trailing_whitespace = false

# YAML has no tabs. A tab in a workflow file is a parse error, not a style
# preference.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2
